  5674 00002A0B 8B1E6C00                    mov bx, [0x006C]
  5675 00002A0F 31D2                        xor dx, dx                      ; DL tracks an E0 prefix for documentation
  5676                                  
  5677                                      ; During early POST, firmware owns the controller output buffer.  Mask IRQ1
  5678                                      ; so the interrupt handler cannot race this polling loop for port 60h;
  5679                                      ; leave IRQ0 unmasked so the 18.2 Hz deadline remains genuine machine time.
  5680 00002A11 E421                        in al, 0x21
  5681 00002A13 88C1                        mov cl, al
  5682 00002A15 0C02                        or al, 0x02
  5683 00002A17 E621                        out 0x21, al
