  1303                                  ; Private keyboard workspace at the very end of the 1 KiB EBDA.  Current disk
  1304                                  ; workspace ends at 03E8h.  Keep these bytes private to firmware; applications
  1305                                  ; observe only standard BDA/INT 16h state.
  1306                                  ; CMOS Setup owns 03EAh-03F5h.  Keep the runtime keyboard state above it;
  1307                                  ; overlapping these areas corrupts typematic/E1/Alt-numpad state on Setup use.
  1308                                  %define KBW_TYPEMATIC        0x03F6
  1309                                  %define KBW_POWER_BAT_SEEN   0x03F7
