  1286                                  ; CROMWELL KEYBOARD REALITY BRICK 2 BEGIN
  1287                                  ; ---------------------------------------------------------------------------
  1288                                  ; Cromwell Technologies AT enhanced-keyboard BIOS
  1289                                  ; Real 8042/keyboard transport.  IRQ1 consumes translated Set-1 bytes only.
  1290                                  ; ---------------------------------------------------------------------------
  1291                                  %define BDA_KBD_FLAGS1       0x0017
  1292                                  %define BDA_KBD_FLAGS2       0x0018
  1293                                  %define BDA_ALT_NUMPAD       0x0019
