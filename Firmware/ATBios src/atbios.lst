    10                                  
    11                                  ; 80286-safe arbitrary-distance conditional branches. Each macro uses a
    12                                  ; short inverse condition over a normal near JMP; no 386 near-Jcc opcodes.
    13                                  %macro J286_E 1
    14                                      jne short %%skip
    15                                      jmp %1
    16                                  %%skip:
    17                                  %endmacro
    18                                  %macro J286_NE 1
    19                                      je short %%skip
    20                                      jmp %1
    21                                  %%skip:
    22                                  %endmacro
    23                                  %macro J286_AE 1
    24                                      jb short %%skip
    25                                      jmp %1
    26                                  %%skip:
    27                                  %endmacro
    28                                  %macro J286_C 1
    29                                      jnc short %%skip
    30                                      jmp %1
    31                                  %%skip:
    32                                  %endmacro
    33                                  %macro J286_B 1
    34                                      jae short %%skip
    35                                      jmp %1
    36                                  %%skip:
    37                                  %endmacro
    38                                  %macro J286_BE 1
    39                                      ja short %%skip
    40                                      jmp %1
    41                                  %%skip:
    42                                  %endmacro
    43                                  %macro J286_A 1
    44                                      jbe short %%skip
    45                                      jmp %1
    46                                  %%skip:
    47                                  %endmacro
    48                                  %macro J286_NC 1
    49                                      jc short %%skip
    50                                      jmp %1
    51                                  %%skip:
    52                                  %endmacro
