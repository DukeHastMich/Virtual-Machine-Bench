  1039 000006FF 7504                        jne short .changed
  1040 00000701 E2F6                        loop .wait
  1041 00000703 EB05                        jmp short .finish
  1042                                  .changed:
  1043 00000705 88C2                        mov dl, al
  1044 00000707 4E                          dec si
  1045 00000708 75EC                        jnz short .edge
  1046                                  .finish:
