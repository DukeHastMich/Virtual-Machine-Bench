  1672                                  ; Runtime keyboard helpers ---------------------------------------------------
  1673                                  ; These helpers operate with DS = BDA_SEG.  They use the same physical
  1674                                  ; controller/keyboard command path POST used; no host-side state is consulted.
  1675                                  
  1676                                  ; AL = byte to send to the keyboard.  Wait for ACK, retry on RESEND.
  1677                                  ; Returns CF set on timeout/error.  Keyboard command responses bypass the
  1678                                  ; 8042 scan-code translator in Keyboard Reality Brick 2.
  1679                                  kbd_runtime_send:
  1680 00000B14 53                          push bx
  1681 00000B15 51                          push cx
  1682 00000B16 52                          push dx
  1683 00000B17 88C3                        mov bl, al
  1684 00000B19 B203                        mov dl, 3
  1685                                  .retry:
  1686 00000B1B 80269700CF                  and byte [BDA_KBD_STATUS4], 0xCF     ; clear ACK/RESEND observations
  1687 00000B20 88D8                        mov al, bl
  1688 00000B22 E8B9FD                      call kbc_write_data
  1689 00000B25 7238                        jc short .failed
  1690                                  .wait:
  1691                                      ; With IRQ1 enabled the interrupt handler may consume FAh/FEh before this
  1692                                      ; foreground command path observes port 64h.  INT 09h records that physical
