  1466 000009B7 7310                        jnc short .read_response
  1467 000009B9 F606970010                  test byte [BDA_KBD_STATUS4], 0x10
  1468 000009BE 7528                        jnz short .acked
  1469 000009C0 F606970020                  test byte [BDA_KBD_STATUS4], 0x20
  1470 000009C5 750E                        jnz short .resend
