  7116                                  ; Secondary IDE was added after the original BIOS image layout was frozen.
  7117                                  ; Keep this helper in the previously unused ROM padding so the historical code
  7118                                  ; offsets remain stable while installing INT 76h and INT 77h at POST.
  7119                                  install_disk_irq_vectors:
  7120 00003F29 C706D801[7308]              mov word [0x76*4], int76
  7120          ******************       warning: 16-bit absolute section-crossing relocation [-w+reloc-abs-word]
  7121 00003F2F C706DC01[363F]              mov word [0x77*4], int77
  7121          ******************       warning: 16-bit absolute section-crossing relocation [-w+reloc-abs-word]
  7122 00003F35 C3                          ret
  7123                                  
  7124                                  ; IRQ15 / INT 77h secondary-IDE completion handler.  Unlike the IBM primary
  7125                                  ; fixed-disk handler above, do not set BDA 40:8Eh: that flag belongs to the
  7126                                  ; primary BIOS fixed-disk path.  The essential hardware job here is to EOI both
  7127                                  ; cascaded PICs so a DOS/Windows IDE driver can own the secondary channel.
  7128                                  int77:
  7129 00003F36 50                          push ax
  7130 00003F37 B020                        mov al, 0x20
  7131 00003F39 E6A0                        out 0xA0, al
  7132 00003F3B E620                        out 0x20, al
  7133 00003F3D 58                          pop ax
  7134 00003F3E CF                          iret
  7135                                  
  7136                                  ; IBM Cassette BASIC occupies its historical 32 KiB F6000h-FDFFFh window.
  7137                                  ; The active Phalanx BIOS code/data is deliberately kept below offset 6000h;
  7138                                  ; therefore BASIC does not overlap executable BIOS content and no host-side
  7139                                  ; dynamic mapping shortcut is required.
  7140 00003F3F FF<rep 20C1h>           times 0x6000-($-$$) db 0xFF
