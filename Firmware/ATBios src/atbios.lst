   847 000005BD C3                          ret
   848                                  
   849                                  ; ---------------------------------------------------------------------------
   850                                  ; PC/AT CMOS/RTC services (Motorola MC146818A at ports 70h/71h)
   851                                  ; ---------------------------------------------------------------------------
   852                                  
   853                                  ; AL = CMOS index, returns AL = value. NMI is left enabled while selecting.
   854                                  cmos_read:
   855 000005BE 52                          push dx
   856 000005BF BA7000                      mov dx, 0x70
   857 000005C2 EE                          out dx, al
   858 000005C3 42                          inc dx
   859 000005C4 EC                          in al, dx
   860 000005C5 5A                          pop dx
   861 000005C6 C3                          ret
   862                                  
   863                                  ; AL = CMOS index, AH = value.
   864                                  cmos_write:
   865 000005C7 52                          push dx
   866 000005C8 BA7000                      mov dx, 0x70
   867 000005CB EE                          out dx, al
   868 000005CC 42                          inc dx
   869 000005CD 88E0                        mov al, ah
   870 000005CF EE                          out dx, al
   871 000005D0 5A                          pop dx
   872 000005D1 C3                          ret
   873                                  
   874                                  cmos_wait_update:
   875 000005D2 50                          push ax
   876                                  .wait:
   877 000005D3 B00A                        mov al, 0x0A
   878 000005D5 E8E6FF                      call cmos_read
   879 000005D8 A880                        test al, 0x80
   880 000005DA 75F7                        jnz .wait
   881 000005DC 58                          pop ax
   882 000005DD C3                          ret
   883                                  
   884                                  ; Return the 16-bit unsigned sum of CMOS bytes 10h through 20h in BX.
   885                                  cmos_compute_checksum:
   886 000005DE 50                          push ax
   887 000005DF 51                          push cx
   888 000005E0 31DB                        xor bx, bx
   889 000005E2 B110                        mov cl, 0x10
   890                                  .next:
   891 000005E4 88C8                        mov al, cl
   892 000005E6 E8D5FF                      call cmos_read
   893 000005E9 30E4                        xor ah, ah
   894 000005EB 01C3                        add bx, ax
   895 000005ED FEC1                        inc cl
   896 000005EF 80F921                      cmp cl, 0x21
   897 000005F2 75F0                        jne .next
   898 000005F4 59                          pop cx
   899 000005F5 58                          pop ax
   900 000005F6 C3                          ret
   901                                  
   902                                  cmos_write_checksum:
   903 000005F7 50                          push ax
   904 000005F8 53                          push bx
   905 000005F9 E8E2FF                      call cmos_compute_checksum
   906 000005FC B02E                        mov al, 0x2E
   907 000005FE 88FC                        mov ah, bh
   908 00000600 E8C4FF                      call cmos_write
   909 00000603 B02F                        mov al, 0x2F
   910 00000605 88DC                        mov ah, bl
   911 00000607 E8BDFF                      call cmos_write
   912 0000060A 5B                          pop bx
   913 0000060B 58                          pop ax
   914 0000060C C3                          ret
   915                                  
   916                                  ; Establish the late-AT/AMI-style defaults used by this motherboard profile.
   917                                  ; Disk presence is synchronized after ATA IDENTIFY completes.
   918                                  cmos_load_defaults:
   919 0000060D 50                          push ax
   920 0000060E B80A26                      mov ax, 0x260A                 ; 32.768 kHz divider, 1024 Hz periodic rate
   921 00000611 E8B3FF                      call cmos_write
   922 00000614 B80B02                      mov ax, 0x020B                 ; BCD, 24-hour, RTC interrupts disabled
   923 00000617 E8ADFF                      call cmos_write
   924 0000061A B80E00                      mov ax, 0x000E                 ; diagnostics good
   925 0000061D E8A7FF                      call cmos_write
   926 00000620 B80F00                      mov ax, 0x000F                 ; normal power-on shutdown state
   927 00000623 E8A1FF                      call cmos_write
   928 00000626 B81044                      mov ax, 0x4410                 ; A: and B: are 1.44 MB drives (AMI extension)
   929 00000629 E89BFF                      call cmos_write
   930 0000062C B81200                      mov ax, 0x0012                 ; no fixed disk until ATA detection
   931 0000062F E895FF                      call cmos_write
   932 00000632 B81463                      mov ax, 0x6314                 ; 2 floppies, 80-column color, 80287 present
   933 00000635 E88FFF                      call cmos_write
   934 00000638 B81580                      mov ax, 0x8015                 ; 640 KiB base memory (0280h)
   935 0000063B E889FF                      call cmos_write
   936 0000063E B81602                      mov ax, 0x0216
   937 00000641 E883FF                      call cmos_write
   938 00000644 B81700                      mov ax, 0x0017                 ; POST fills discovered extended memory
   939 00000647 E87DFF                      call cmos_write
   940 0000064A B81800                      mov ax, 0x0018
   941 0000064D E877FF                      call cmos_write
   942 00000650 B81900                      mov ax, 0x0019                 ; no extended fixed-disk type yet
   943 00000653 E871FF                      call cmos_write
   944 00000656 B82001                      mov ax, 0x0120                 ; OEM setup flags: boot Num Lock on, floppy first
   945 00000659 E86BFF                      call cmos_write
   946 0000065C B83000                      mov ax, 0x0030                 ; POST fills discovered extended memory
   947 0000065F E865FF                      call cmos_write
   948 00000662 B83100                      mov ax, 0x0031
   949 00000665 E85FFF                      call cmos_write
   950 00000668 E88CFF                      call cmos_write_checksum
   951 0000066B 58                          pop ax
   952 0000066C C3                          ret
   953                                  
   954                                  ; Validate battery-backed configuration RAM and initialize RTC operating mode.
   955                                  cmos_validate_or_default:
   956 0000066D 50                          push ax
   957 0000066E 53                          push bx
   958 0000066F 52                          push dx
   959 00000670 B00D                        mov al, 0x0D
   960 00000672 E849FF                      call cmos_read
   961 00000675 A880                        test al, 0x80                  ; register D valid-RAM bit
   962 00000677 7425                        jz .defaults
   963                                  
   964 00000679 E862FF                      call cmos_compute_checksum
   965 0000067C B02E                        mov al, 0x2E
   966 0000067E E83DFF                      call cmos_read
   967 00000681 88C6                        mov dh, al
   968 00000683 B02F                        mov al, 0x2F
   969 00000685 E836FF                      call cmos_read
   970 00000688 88C2                        mov dl, al
   971 0000068A 39D3                        cmp bx, dx
   972 0000068C 7510                        jne .defaults
   973                                  
   974 0000068E B00E                        mov al, 0x0E
   975 00000690 E82BFF                      call cmos_read
   976 00000693 243F                        and al, 0x3F                  ; clear battery/checksum diagnostic flags
   977 00000695 88C4                        mov ah, al
   978 00000697 B00E                        mov al, 0x0E
   979 00000699 E82BFF                      call cmos_write
   980 0000069C EB03                        jmp .mode
   981                                  .defaults:
   982 0000069E E86CFF                      call cmos_load_defaults
   983                                  .mode:
   984 000006A1 B80A26                      mov ax, 0x260A
   985 000006A4 E820FF                      call cmos_write
   986 000006A7 B80B02                      mov ax, 0x020B
   987 000006AA E81AFF                      call cmos_write
   988 000006AD B00C                        mov al, 0x0C                  ; reading C clears any stale IRQ8 source
   989 000006AF E80CFF                      call cmos_read
   990 000006B2 5A                          pop dx
   991 000006B3 5B                          pop bx
   992 000006B4 58                          pop ax
   993 000006B5 C3                          ret
   994                                  
   995                                  ; Reflect ATA master presence in the AMI extended drive-type convention:
   996                                  ; type F in byte 12h and user type 47 in byte 19h.
   997                                  cmos_sync_detected_hardware:
   998 000006B6 50                          push ax
   999 000006B7 1E                          push ds
  1000 000006B8 B8C09F                      mov ax, EBDA_SEG
  1001 000006BB 8ED8                        mov ds, ax
  1002 000006BD 803EE80301                  cmp byte [HD_PRESENT], 1
  1003 000006C2 1F                          pop ds
  1004 000006C3 750E                        jne .absent
  1005 000006C5 B812F0                      mov ax, 0xF012
  1006 000006C8 E8FCFE                      call cmos_write
  1007 000006CB B8192F                      mov ax, 0x2F19                 ; decimal 47
  1008 000006CE E8F6FE                      call cmos_write
  1009 000006D1 EB0C                        jmp .checksum
  1010                                  .absent:
  1011 000006D3 B81200                      mov ax, 0x0012
  1012 000006D6 E8EEFE                      call cmos_write
  1013 000006D9 B81900                      mov ax, 0x0019
  1014 000006DC E8E8FE                      call cmos_write
  1015                                  .checksum:
  1016 000006DF E815FF                      call cmos_write_checksum
  1017 000006E2 58                          pop ax
  1018 000006E3 C3                          ret
  1019                                  
  1020                                  ; IRQ8 handler. Reading register C clears PF/AF/UF and releases the RTC IRQ.
  1021                                  int70:
  1022 000006E4 50                          push ax
  1023 000006E5 B00C                        mov al, 0x0C
  1024 000006E7 E8D4FE                      call cmos_read
  1025 000006EA B020                        mov al, 0x20
  1026 000006EC E6A0                        out 0xA0, al
  1027 000006EE E620                        out 0x20, al
  1028 000006F0 58                          pop ax
  1029 000006F1 CF                          iret
  1030                                  
  1031                                  ; IRQ14 / INT 76h fixed-disk completion handler.  The IBM AT BIOS contract
  1032                                  ; records completion in BDA byte 40:8Eh bit 7.  DOS IDE/ATAPI drivers such as
  1033                                  ; VIDE-CDD use that flag while waiting for the primary-channel interrupt.
  1034                                  ; A slave-PIC interrupt must be ended at both controllers, slave first.
  1035                                  int76:
  1036 000006F2 50                          push ax
  1037 000006F3 1E                          push ds
  1038 000006F4 B84000                      mov ax, BDA_SEG
  1039 000006F7 8ED8                        mov ds, ax
  1040 000006F9 800E8E0080                  or byte [0x8E], 0x80
  1041 000006FE B020                        mov al, 0x20
  1042 00000700 E6A0                        out 0xA0, al
  1043 00000702 E620                        out 0x20, al
  1044 00000704 1F                          pop ds
  1045 00000705 58                          pop ax
  1046 00000706 CF                          iret
  1047                                  
  1048                                  ; CROMWELL KEYBOARD REALITY BRICK 2 BEGIN
  1049                                  ; ---------------------------------------------------------------------------
  1050                                  ; Cromwell Technologies AT enhanced-keyboard BIOS
  1051                                  ; Real 8042/keyboard transport.  IRQ1 consumes translated Set-1 bytes only.
  1052                                  ; ---------------------------------------------------------------------------
  1053                                  %define BDA_KBD_FLAGS1       0x0017
  1054                                  %define BDA_KBD_FLAGS2       0x0018
  1055                                  %define BDA_ALT_NUMPAD       0x0019
  1056                                  %define BDA_KBD_HEAD         0x001A
  1057                                  %define BDA_KBD_TAIL         0x001C
  1058                                  %define BDA_BREAK_FLAG       0x0071
  1059                                  %define BDA_WARM_BOOT        0x0072
  1060                                  %define BDA_KBD_START        0x0080
  1061                                  %define BDA_KBD_END          0x0082
  1062                                  %define BDA_KBD_STATUS3      0x0096
  1063                                  %define BDA_KBD_STATUS4      0x0097
  1064                                  
  1065                                  ; Private keyboard workspace at the very end of the 1 KiB EBDA.  Current disk
  1066                                  ; workspace ends at 03E8h.  Keep these bytes private to firmware; applications
  1067                                  ; observe only standard BDA/INT 16h state.
  1068                                  ; CMOS Setup owns 03EAh-03F5h.  Keep the runtime keyboard state above it;
  1069                                  ; overlapping these areas corrupts typematic/E1/Alt-numpad state on Setup use.
  1070                                  %define KBW_TYPEMATIC        0x03F6
  1071                                  %define KBW_POWER_BAT_SEEN   0x03F7
  1072                                  %define KBW_E1_INDEX         0x03F8
  1073                                  %define KBW_ALT_NUM_ACTIVE   0x03F9
  1074                                  %define KBW_COMMAND_BUSY     0x03FA
  1075                                  %define KBW_LED_PENDING      0x03FB
  1076                                  %define KBW_COMMAND_BYTE     0x03FC
  1077                                  %define KBW_COMMAND_DATA     0x03FD
  1078                                  
  1079                                  ; Controller polling helpers -------------------------------------------------
  1080                                  kbc_wait_ibf_clear:
  1081 00000707 51                          push cx
  1082 00000708 B9FFFF                      mov cx, 0xFFFF
  1083                                  .wait:
  1084 0000070B E464                        in al, 0x64
  1085 0000070D A802                        test al, 2
  1086 0000070F 7405                        jz short .ready
  1087 00000711 E2F8                        loop .wait
  1088 00000713 F9                          stc
  1089 00000714 59                          pop cx
  1090 00000715 C3                          ret
  1091                                  .ready:
  1092 00000716 F8                          clc
  1093 00000717 59                          pop cx
  1094 00000718 C3                          ret
  1095                                  
  1096                                  kbc_wait_obf_short:
  1097 00000719 51                          push cx
  1098 0000071A 52                          push dx
  1099 0000071B BA0800                      mov dx, 8
  1100                                  .outer:
  1101 0000071E B9FFFF                      mov cx, 0xFFFF
  1102                                  .inner:
  1103 00000721 E464                        in al, 0x64
  1104 00000723 A801                        test al, 1
  1105 00000725 7509                        jnz short .ready
  1106 00000727 E2F8                        loop .inner
  1107 00000729 4A                          dec dx
  1108 0000072A 75F2                        jnz short .outer
  1109 0000072C F9                          stc
  1110 0000072D 5A                          pop dx
  1111 0000072E 59                          pop cx
  1112 0000072F C3                          ret
  1113                                  .ready:
  1114 00000730 F8                          clc
  1115 00000731 5A                          pop dx
  1116 00000732 59                          pop cx
  1117 00000733 C3                          ret
  1118                                  
  1119                                  kbc_wait_obf_long:
  1120 00000734 51                          push cx
  1121 00000735 52                          push dx
  1122 00000736 BA5000                      mov dx, 80
  1123                                  .outer:
  1124 00000739 B9FFFF                      mov cx, 0xFFFF
  1125                                  .inner:
  1126 0000073C E464                        in al, 0x64
  1127 0000073E A801                        test al, 1
  1128 00000740 7509                        jnz short .ready
  1129 00000742 E2F8                        loop .inner
  1130 00000744 4A                          dec dx
  1131 00000745 75F2                        jnz short .outer
  1132 00000747 F9                          stc
  1133 00000748 5A                          pop dx
  1134 00000749 59                          pop cx
  1135 0000074A C3                          ret
  1136                                  .ready:
  1137 0000074B F8                          clc
  1138 0000074C 5A                          pop dx
  1139 0000074D 59                          pop cx
  1140 0000074E C3                          ret
  1141                                  
  1142                                  ; AL = controller command.
  1143                                  kbc_write_command:
  1144 0000074F 50                          push ax
  1145 00000750 E8B4FF                      call kbc_wait_ibf_clear
  1146 00000753 7205                        jc short .fail
  1147 00000755 58                          pop ax
  1148 00000756 E664                        out 0x64, al
  1149 00000758 F8                          clc
  1150 00000759 C3                          ret
  1151                                  .fail:
  1152 0000075A 58                          pop ax
  1153 0000075B F9                          stc
  1154 0000075C C3                          ret
  1155                                  
  1156                                  ; AL = byte for port 60h (controller parameter or keyboard byte).
  1157                                  kbc_write_data:
  1158 0000075D 50                          push ax
  1159 0000075E E8A6FF                      call kbc_wait_ibf_clear
  1160 00000761 7205                        jc short .fail
  1161 00000763 58                          pop ax
  1162 00000764 E660                        out 0x60, al
  1163 00000766 F8                          clc
  1164 00000767 C3                          ret
  1165                                  .fail:
  1166 00000768 58                          pop ax
  1167 00000769 F9                          stc
  1168 0000076A C3                          ret
  1169                                  
  1170                                  ; AL expected controller/keyboard response, ES = EBDA.  Keyboard power-on BAT
  1171                                  ; may arrive while a controller test response is pending; remember it and keep
  1172                                  ; waiting for the requested byte.
  1173                                  kbc_expect_short:
  1174 0000076B 53                          push bx
  1175 0000076C 88C3                        mov bl, al
  1176                                  .next:
  1177 0000076E E8A8FF                      call kbc_wait_obf_short
  1178 00000771 7215                        jc short .fail
  1179 00000773 E460                        in al, 0x60
  1180 00000775 38D8                        cmp al, bl
  1181 00000777 740C                        je short .ok
  1182 00000779 3CAA                        cmp al, 0xAA
  1183 0000077B 75F1                        jne short .next
  1184 0000077D 26C606F70301                mov byte [es:KBW_POWER_BAT_SEEN], 1
  1185 00000783 EBE9                        jmp short .next
  1186                                  .ok:
  1187 00000785 F8                          clc
  1188 00000786 5B                          pop bx
  1189 00000787 C3                          ret
  1190                                  .fail:
  1191 00000788 F9                          stc
  1192 00000789 5B                          pop bx
  1193 0000078A C3                          ret
  1194                                  
  1195                                  kbc_expect_long:
  1196 0000078B 53                          push bx
  1197 0000078C 88C3                        mov bl, al
  1198                                  .next:
  1199 0000078E E8A3FF                      call kbc_wait_obf_long
  1200 00000791 7215                        jc short .fail
  1201 00000793 E460                        in al, 0x60
  1202 00000795 38D8                        cmp al, bl
  1203 00000797 740C                        je short .ok
  1204 00000799 3CAA                        cmp al, 0xAA
  1205 0000079B 75F1                        jne short .next
  1206 0000079D 26C606F70301                mov byte [es:KBW_POWER_BAT_SEEN], 1
  1207 000007A3 EBE9                        jmp short .next
  1208                                  .ok:
  1209 000007A5 F8                          clc
  1210 000007A6 5B                          pop bx
  1211 000007A7 C3                          ret
  1212                                  .fail:
  1213 000007A8 F9                          stc
  1214 000007A9 5B                          pop bx
  1215 000007AA C3                          ret
  1216                                  
  1217                                  ; Send one keyboard byte during POST.  Scanning is disabled before this helper
  1218                                  ; is used for configuration, so only ACK/RESEND/BAT traffic can legitimately
  1219                                  ; appear. AL = keyboard byte.
  1220                                  kbd_init_send:
  1221 000007AB 53                          push bx
  1222 000007AC 52                          push dx
  1223 000007AD 88C3                        mov bl, al
  1224 000007AF B203                        mov dl, 3
  1225                                  .retry:
  1226 000007B1 88D8                        mov al, bl
  1227 000007B3 E8A7FF                      call kbc_write_data
  1228 000007B6 721F                        jc short .fail
  1229                                  .wait_response:
  1230 000007B8 E85EFF                      call kbc_wait_obf_short
  1231 000007BB 721A                        jc short .fail
  1232 000007BD E460                        in al, 0x60
  1233 000007BF 3CFA                        cmp al, 0xFA
  1234 000007C1 7418                        je short .ok
  1235 000007C3 3CFE                        cmp al, 0xFE
  1236 000007C5 740C                        je short .resend
  1237 000007C7 3CAA                        cmp al, 0xAA
  1238 000007C9 75ED                        jne short .wait_response
  1239 000007CB 26C606F70301                mov byte [es:KBW_POWER_BAT_SEEN], 1
  1240 000007D1 EBE5                        jmp short .wait_response
  1241                                  .resend:
  1242 000007D3 FECA                        dec dl
  1243 000007D5 75DA                        jnz short .retry
  1244                                  .fail:
  1245 000007D7 F9                          stc
  1246 000007D8 5A                          pop dx
  1247 000007D9 5B                          pop bx
  1248 000007DA C3                          ret
  1249                                  .ok:
  1250 000007DB F8                          clc
  1251 000007DC 5A                          pop dx
  1252 000007DD 5B                          pop bx
  1253 000007DE C3                          ret
  1254                                  
  1255                                  ; POST keyboard/controller initialization -----------------------------------
  1256                                  keyboard_init:
  1257 000007DF 50                          push ax
  1258 000007E0 53                          push bx
  1259 000007E1 51                          push cx
  1260 000007E2 52                          push dx
  1261 000007E3 1E                          push ds
  1262 000007E4 06                          push es
  1263                                  
  1264 000007E5 B84000                      mov ax, BDA_SEG
  1265 000007E8 8ED8                        mov ds, ax
  1266 000007EA C606170000                  mov byte [BDA_KBD_FLAGS1], 0
  1267 000007EF C606180000                  mov byte [BDA_KBD_FLAGS2], 0
  1268 000007F4 C606190000                  mov byte [BDA_ALT_NUMPAD], 0
  1269 000007F9 C7061A001E00                mov word [BDA_KBD_HEAD], 0x001E
  1270 000007FF C7061C001E00                mov word [BDA_KBD_TAIL], 0x001E
  1271 00000805 C606710000                  mov byte [BDA_BREAK_FLAG], 0
  1272 0000080A C70680001E00                mov word [BDA_KBD_START], 0x001E
  1273 00000810 C70682003E00                mov word [BDA_KBD_END], 0x003E
  1274 00000816 C606960000                  mov byte [BDA_KBD_STATUS3], 0
  1275 0000081B C606970000                  mov byte [BDA_KBD_STATUS4], 0
  1276                                  
  1277 00000820 B8C09F                      mov ax, EBDA_SEG
  1278 00000823 8EC0                        mov es, ax
  1279 00000825 26C606F6032B                mov byte [es:KBW_TYPEMATIC], 0x2B
  1280 0000082B 26C606F70300                mov byte [es:KBW_POWER_BAT_SEEN], 0
  1281 00000831 26C606F80300                mov byte [es:KBW_E1_INDEX], 0
  1282 00000837 26C606F90300                mov byte [es:KBW_ALT_NUM_ACTIVE], 0
  1283 0000083D 26C606FA0300                mov byte [es:KBW_COMMAND_BUSY], 0
  1284 00000843 26C606FB0300                mov byte [es:KBW_LED_PENDING], 0
  1285 00000849 26C606FE0380                mov byte [es:KBW_POST_RESULT], 0x80 ; controller/self-test stage
  1286                                  
  1287 0000084F B021                        mov al, 0x21
  1288 00000851 E680                        out 0x80, al
  1289                                  
  1290                                      ; Capture a power-on BAT byte if the keyboard finished before POST arrived.
  1291 00000853 E464                        in al, 0x64
  1292 00000855 A801                        test al, 1
  1293 00000857 740C                        jz short .disable
  1294 00000859 E460                        in al, 0x60
  1295 0000085B 3CAA                        cmp al, 0xAA
  1296 0000085D 7506                        jne short .disable
  1297 0000085F 26C606F70301                mov byte [es:KBW_POWER_BAT_SEEN], 1
