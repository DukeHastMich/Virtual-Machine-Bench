  1249                                  ; CROMWELL KEYBOARD REALITY BRICK 2 BEGIN
  1250                                  ; ---------------------------------------------------------------------------
  1251                                  ; Cromwell Technologies AT enhanced-keyboard BIOS
  1252                                  ; Real 8042/keyboard transport.  IRQ1 consumes translated Set-1 bytes only.
  1253                                  ; ---------------------------------------------------------------------------
  1254                                  %define BDA_KBD_FLAGS1       0x0017
  1255                                  %define BDA_KBD_FLAGS2       0x0018
  1256                                  %define BDA_ALT_NUMPAD       0x0019
  1257                                  %define BDA_KBD_HEAD         0x001A
  1258                                  %define BDA_KBD_TAIL         0x001C
  1259                                  %define BDA_BREAK_FLAG       0x0071
  1260                                  %define BDA_WARM_BOOT        0x0072
  1261                                  %define BDA_KBD_START        0x0080
  1262                                  %define BDA_KBD_END          0x0082
  1263                                  %define BDA_KBD_STATUS3      0x0096
  1264                                  %define BDA_KBD_STATUS4      0x0097
  1265                                  
  1266                                  ; Private keyboard workspace at the very end of the 1 KiB EBDA.  Current disk
  1267                                  ; workspace ends at 03E8h.  Keep these bytes private to firmware; applications
  1268                                  ; observe only standard BDA/INT 16h state.
  1269                                  ; CMOS Setup owns 03EAh-03F5h.  Keep the runtime keyboard state above it;
  1270                                  ; overlapping these areas corrupts typematic/E1/Alt-numpad state on Setup use.
  1271                                  %define KBW_TYPEMATIC        0x03F6
  1272                                  %define KBW_POWER_BAT_SEEN   0x03F7
  1273                                  %define KBW_E1_INDEX         0x03F8
  1274                                  %define KBW_ALT_NUM_ACTIVE   0x03F9
  1275                                  %define KBW_COMMAND_BUSY     0x03FA
  1276                                  %define KBW_LED_PENDING      0x03FB
  1277                                  %define KBW_COMMAND_BYTE     0x03FC
  1278                                  %define KBW_COMMAND_DATA     0x03FD
  1279                                  
