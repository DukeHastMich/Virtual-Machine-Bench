  5277 000026E6 31D2                        xor dx, dx                      ; DL tracks an E0 prefix for documentation
  5278                                  
  5279                                      ; During early POST, firmware owns the controller output buffer.  Mask IRQ1
  5280                                      ; so the interrupt handler cannot race this polling loop for port 60h;
  5281                                      ; leave IRQ0 unmasked so the 18.2 Hz deadline remains genuine machine time.
  5282 000026E8 E421                        in al, 0x21
  5283 000026EA 88C1                        mov cl, al
  5284 000026EC 0C02                        or al, 0x02
  5285 000026EE E621                        out 0x21, al
