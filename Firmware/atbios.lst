  1117                                  ; Establish the late-AT/AMI-style defaults used by this motherboard profile.
  1118                                  ; Disk presence is synchronized after ATA IDENTIFY completes.
  1119                                  cmos_load_defaults:
  1120 0000074F 50                          push ax
  1121 00000750 B80A26                      mov ax, 0x260A                 ; 32.768 kHz divider, 1024 Hz periodic rate
  1122 00000753 E8B3FF                      call cmos_write
  1123 00000756 B80B02                      mov ax, 0x020B                 ; BCD, 24-hour, RTC interrupts disabled
  1124 00000759 E8ADFF                      call cmos_write
  1125 0000075C B80E00                      mov ax, 0x000E                 ; diagnostics good
  1126 0000075F E8A7FF                      call cmos_write
  1127 00000762 B80F00                      mov ax, 0x000F                 ; normal power-on shutdown state
  1128 00000765 E8A1FF                      call cmos_write
