  1134 00000777 E88FFF                      call cmos_write
  1135 0000077A B81580                      mov ax, 0x8015                 ; 640 KiB base memory (0280h)
  1136 0000077D E889FF                      call cmos_write
  1137 00000780 B81602                      mov ax, 0x0216
  1138 00000783 E883FF                      call cmos_write
