  1140 00000789 E87DFF                      call cmos_write
  1141 0000078C B81800                      mov ax, 0x0018
  1142 0000078F E877FF                      call cmos_write
  1143 00000792 B81900                      mov ax, 0x0019                 ; no extended fixed-disk type yet
  1144 00000795 E871FF                      call cmos_write
