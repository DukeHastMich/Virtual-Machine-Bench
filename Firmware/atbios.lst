  6394                                  
  6395                                  ; Secondary IDE was added after the original BIOS image layout was frozen.
  6396                                  ; Keep this helper in the previously unused ROM padding so the historical code
  6397                                  ; offsets remain stable while installing INT 76h and INT 77h at POST.
  6398                                  install_disk_irq_vectors:
  6399 00003C53 C706D801[3408]              mov word [0x76*4], int76
  6399          ******************       warning: 16-bit absolute section-crossing relocation [-w+reloc-abs-word]
  6400 00003C59 C706DC01[603C]              mov word [0x77*4], int77
  6400          ******************       warning: 16-bit absolute section-crossing relocation [-w+reloc-abs-word]
  6401 00003C5F C3                          ret
  6402                                  
  6403                                  ; IRQ15 / INT 77h secondary-IDE completion handler.  Unlike the IBM primary
  6404                                  ; fixed-disk handler above, do not set BDA 40:8Eh: that flag belongs to the
  6405                                  ; primary BIOS fixed-disk path.  The essential hardware job here is to EOI both
  6406                                  ; cascaded PICs so a DOS/Windows IDE driver can own the secondary channel.
  6407                                  int77:
  6408 00003C60 50                          push ax
  6409 00003C61 B020                        mov al, 0x20
  6410 00003C63 E6A0                        out 0xA0, al
  6411 00003C65 E620                        out 0x20, al
  6412 00003C67 58                          pop ax
  6413 00003C68 CF                          iret
  6414                                  
  6415                                  ; IBM Cassette BASIC occupies its historical 32 KiB F6000h-FDFFFh window.
  6416                                  ; The active Phalanx BIOS code/data is deliberately kept below offset 6000h;
  6417                                  ; therefore BASIC does not overlap executable BIOS content and no host-side
  6418                                  ; dynamic mapping shortcut is required.
  6419 00003C69 FF<rep 2397h>           times 0x6000-($-$$) db 0xFF
  6420                                  basic_rom_start:
  6421 00006000 <bin 8000h>             incbin "basic110.rom"
  6422                                  basic_rom_end:
  6423                                  %if (basic_rom_end-basic_rom_start) != 0x8000
  6424                                      %error "basic110.rom must be exactly 32768 bytes"
  6425                                  %endif
  6426                                  
  6427 0000E000 FF<rep 1FF0h>           times 0xFFF0-($-$$) db 0xFF
  6428 0000FFF0 EA[0000]00F0            reset_vector: jmp 0xF000:start
  6428          ******************       warning: 16-bit absolute section-crossing relocation [-w+reloc-abs-word]
  6429 0000FFF5 FF<rep Bh>              times 0x10000-($-$$) db 0xFF
