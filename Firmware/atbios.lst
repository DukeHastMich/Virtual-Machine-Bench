  4861 0000244E 8ED8                        mov ds, ax
  4862 00002450 8B1E6C00                    mov bx, [0x006C]
  4863 00002454 31D2                        xor dx, dx                      ; DL tracks an E0 prefix for documentation
  4864                                  
  4865                                      ; During early POST, firmware owns the controller output buffer.  Mask IRQ1
  4866                                      ; so the interrupt handler cannot race this polling loop for port 60h;
  4867                                      ; leave IRQ0 unmasked so the 18.2 Hz deadline remains genuine machine time.
  4868 00002456 E421                        in al, 0x21
  4869 00002458 88C1                        mov cl, al
  4870 0000245A 0C02                        or al, 0x02
  4871 0000245C E621                        out 0x21, al
  4872                                  .wait:
  4873 0000245E E464                        in al, 0x64
  4874 00002460 A801                        test al, 0x01                   ; 8042 output buffer full?
  4875 00002462 7410                        jz short .tick
  4876 00002464 E460                        in al, 0x60                     ; translated Set-1 keyboard byte
  4877 00002466 3CE0                        cmp al, 0xE0
  4878 00002468 7504                        jne short .not_prefix
  4879 0000246A B201                        mov dl, 1
  4880 0000246C EBF0                        jmp short .wait
  4881                                  .not_prefix:
