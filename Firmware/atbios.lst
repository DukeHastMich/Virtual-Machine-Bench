  1148 0000074D 58                          pop ax
  1149 0000074E F9                          stc
  1150 0000074F C3                          ret
  1151                                  
  1152                                  ; AL expected controller/keyboard response, ES = EBDA.  Keyboard power-on BAT
  1153                                  ; may arrive while a controller test response is pending; remember it and keep
  1154                                  ; waiting for the requested byte.
  1155                                  kbc_expect_short:
  1156 00000750 53                          push bx
  1157 00000751 88C3                        mov bl, al
  1158                                  .next:
  1159 00000753 E8A8FF                      call kbc_wait_obf_short
  1160 00000756 7215                        jc short .fail
  1161 00000758 E460                        in al, 0x60
  1162 0000075A 38D8                        cmp al, bl
  1163 0000075C 740C                        je short .ok
  1164 0000075E 3CAA                        cmp al, 0xAA
  1165 00000760 75F1                        jne short .next
  1166 00000762 26C606F70301                mov byte [es:KBW_POWER_BAT_SEEN], 1
  1167 00000768 EBE9                        jmp short .next
  1168                                  .ok:
  1169 0000076A F8                          clc
  1170 0000076B 5B                          pop bx
  1171 0000076C C3                          ret
  1172                                  .fail:
  1173 0000076D F9                          stc
  1174 0000076E 5B                          pop bx
  1175 0000076F C3                          ret
  1176                                  
  1177                                  kbc_expect_long:
  1178 00000770 53                          push bx
  1179 00000771 88C3                        mov bl, al
  1180                                  .next:
  1181 00000773 E8A3FF                      call kbc_wait_obf_long
  1182 00000776 7215                        jc short .fail
  1183 00000778 E460                        in al, 0x60
  1184 0000077A 38D8                        cmp al, bl
  1185 0000077C 740C                        je short .ok
  1186 0000077E 3CAA                        cmp al, 0xAA
  1187 00000780 75F1                        jne short .next
  1188 00000782 26C606F70301                mov byte [es:KBW_POWER_BAT_SEEN], 1
  1189 00000788 EBE9                        jmp short .next
  1190                                  .ok:
  1191 0000078A F8                          clc
  1192 0000078B 5B                          pop bx
  1193 0000078C C3                          ret
  1194                                  .fail:
  1195 0000078D F9                          stc
  1196 0000078E 5B                          pop bx
  1197 0000078F C3                          ret
  1198                                  
  1199                                  ; Send one keyboard byte during POST.  Scanning is disabled before this helper
  1200                                  ; is used for configuration, so only ACK/RESEND/BAT traffic can legitimately
  1201                                  ; appear. AL = keyboard byte.
  1202                                  kbd_init_send:
  1203 00000790 53                          push bx
  1204 00000791 52                          push dx
  1205 00000792 88C3                        mov bl, al
  1206 00000794 B203                        mov dl, 3
  1207                                  .retry:
  1208 00000796 88D8                        mov al, bl
  1209 00000798 E8A7FF                      call kbc_write_data
  1210 0000079B 721F                        jc short .fail
  1211                                  .wait_response:
  1212 0000079D E85EFF                      call kbc_wait_obf_short
  1213 000007A0 721A                        jc short .fail
  1214 000007A2 E460                        in al, 0x60
  1215 000007A4 3CFA                        cmp al, 0xFA
  1216 000007A6 7418                        je short .ok
  1217 000007A8 3CFE                        cmp al, 0xFE
  1218 000007AA 740C                        je short .resend
  1219 000007AC 3CAA                        cmp al, 0xAA
  1220 000007AE 75ED                        jne short .wait_response
  1221 000007B0 26C606F70301                mov byte [es:KBW_POWER_BAT_SEEN], 1
  1222 000007B6 EBE5                        jmp short .wait_response
  1223                                  .resend:
  1224 000007B8 FECA                        dec dl
  1225 000007BA 75DA                        jnz short .retry
  1226                                  .fail:
  1227 000007BC F9                          stc
  1228 000007BD 5A                          pop dx
  1229 000007BE 5B                          pop bx
  1230 000007BF C3                          ret
  1231                                  .ok:
  1232 000007C0 F8                          clc
  1233 000007C1 5A                          pop dx
  1234 000007C2 5B                          pop bx
  1235 000007C3 C3                          ret
