  1242 00000840 B020                        mov al, 0x20
  1243 00000842 E6A0                        out 0xA0, al
  1244 00000844 E620                        out 0x20, al
  1245 00000846 1F                          pop ds
  1246 00000847 58                          pop ax
  1247 00000848 CF                          iret
