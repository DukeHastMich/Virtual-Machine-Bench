  1433 00000989 7238                        jc short .failed
  1434                                  .wait:
  1435                                      ; With IRQ1 enabled the interrupt handler may consume FAh/FEh before this
  1436                                      ; foreground command path observes port 64h.  INT 09h records that physical
  1437                                      ; response in BDA_KBD_STATUS4.  Honor the ISR-owned observation both before
  1438                                      ; and after the bounded OBF wait; otherwise a successful EDh can time out
  1439                                      ; after its ACK and leave the real keyboard waiting for its parameter with
  1440                                      ; scanning suspended.  Do not CLI around the transaction: an edge-triggered
  1441                                      ; IRQ1 would remain pending after a polled read and deliver a false empty-OBF
  1442                                      ; interrupt when FLAGS were restored.
  1443 0000098B F606970010                  test byte [BDA_KBD_STATUS4], 0x10
  1444 00000990 753B                        jnz short .acked
  1445 00000992 F606970020                  test byte [BDA_KBD_STATUS4], 0x20
  1446 00000997 7521                        jnz short .resend
  1447 00000999 E862FD                      call kbc_wait_obf_short
  1448 0000099C 7310                        jnc short .read_response
  1449 0000099E F606970010                  test byte [BDA_KBD_STATUS4], 0x10
  1450 000009A3 7528                        jnz short .acked
  1451 000009A5 F606970020                  test byte [BDA_KBD_STATUS4], 0x20
  1452 000009AA 750E                        jnz short .resend
  1453 000009AC EB15                        jmp short .failed
  1454                                  .read_response:
  1455 000009AE E460                        in al, 0x60
