   849                                  ; PC/AT CMOS/RTC services (Motorola MC146818A at ports 70h/71h)
   850                                  ; ---------------------------------------------------------------------------
   851                                  
   852                                  ; AL = CMOS index, returns AL = value. NMI is left enabled while selecting.
   853                                  cmos_read:
   854 000005B8 52                          push dx
   855 000005B9 BA7000                      mov dx, 0x70
   856 000005BC EE                          out dx, al
   857 000005BD 42                          inc dx
   858 000005BE EC                          in al, dx
   859 000005BF 5A                          pop dx
   860 000005C0 C3                          ret
   861                                  
   862                                  ; AL = CMOS index, AH = value.
   863                                  cmos_write:
   864 000005C1 52                          push dx
   865 000005C2 BA7000                      mov dx, 0x70
   866 000005C5 EE                          out dx, al
   867 000005C6 42                          inc dx
   868 000005C7 88E0                        mov al, ah
   869 000005C9 EE                          out dx, al
   870 000005CA 5A                          pop dx
   871 000005CB C3                          ret
   872                                  
   873                                  cmos_wait_update:
   874 000005CC 50                          push ax
   875                                  .wait:
   876 000005CD B00A                        mov al, 0x0A
   877 000005CF E8E6FF                      call cmos_read
   878 000005D2 A880                        test al, 0x80
   879 000005D4 75F7                        jnz .wait
   880 000005D6 58                          pop ax
   881 000005D7 C3                          ret
   882                                  
   883                                  ; Return the 16-bit unsigned sum of CMOS bytes 10h through 20h in BX.
   884                                  cmos_compute_checksum:
   885 000005D8 50                          push ax
   886 000005D9 51                          push cx
   887 000005DA 31DB                        xor bx, bx
   888 000005DC B110                        mov cl, 0x10
   889                                  .next:
   890 000005DE 88C8                        mov al, cl
   891 000005E0 E8D5FF                      call cmos_read
   892 000005E3 30E4                        xor ah, ah
   893 000005E5 01C3                        add bx, ax
   894 000005E7 FEC1                        inc cl
   895 000005E9 80F921                      cmp cl, 0x21
   896 000005EC 75F0                        jne .next
   897 000005EE 59                          pop cx
   898 000005EF 58                          pop ax
   899 000005F0 C3                          ret
   900                                  
   901                                  cmos_write_checksum:
   902 000005F1 50                          push ax
   903 000005F2 53                          push bx
   904 000005F3 E8E2FF                      call cmos_compute_checksum
   905 000005F6 B02E                        mov al, 0x2E
   906 000005F8 88FC                        mov ah, bh
   907 000005FA E8C4FF                      call cmos_write
   908 000005FD B02F                        mov al, 0x2F
   909 000005FF 88DC                        mov ah, bl
   910 00000601 E8BDFF                      call cmos_write
   911 00000604 5B                          pop bx
   912 00000605 58                          pop ax
   913 00000606 C3                          ret
   914                                  
   915                                  ; Establish the late-AT/AMI-style defaults used by this motherboard profile.
   916                                  ; Disk presence is synchronized after ATA IDENTIFY completes.
   917                                  cmos_load_defaults:
   918 00000607 50                          push ax
   919 00000608 B80A26                      mov ax, 0x260A                 ; 32.768 kHz divider, 1024 Hz periodic rate
   920 0000060B E8B3FF                      call cmos_write
   921 0000060E B80B02                      mov ax, 0x020B                 ; BCD, 24-hour, RTC interrupts disabled
   922 00000611 E8ADFF                      call cmos_write
   923 00000614 B80E00                      mov ax, 0x000E                 ; diagnostics good
   924 00000617 E8A7FF                      call cmos_write
   925 0000061A B80F00                      mov ax, 0x000F                 ; normal power-on shutdown state
   926 0000061D E8A1FF                      call cmos_write
   927 00000620 B81044                      mov ax, 0x4410                 ; A: and B: are 1.44 MB drives (AMI extension)
   928 00000623 E89BFF                      call cmos_write
   929 00000626 B81200                      mov ax, 0x0012                 ; no fixed disk until ATA detection
   930 00000629 E895FF                      call cmos_write
   931 0000062C B81463                      mov ax, 0x6314                 ; 2 floppies, 80-column color, 80287 present
   932 0000062F E88FFF                      call cmos_write
   933 00000632 B81580                      mov ax, 0x8015                 ; 640 KiB base memory (0280h)
   934 00000635 E889FF                      call cmos_write
   935 00000638 B81602                      mov ax, 0x0216
   936 0000063B E883FF                      call cmos_write
   937 0000063E B81700                      mov ax, 0x0017                 ; POST fills discovered extended memory
   938 00000641 E87DFF                      call cmos_write
   939 00000644 B81800                      mov ax, 0x0018
   940 00000647 E877FF                      call cmos_write
   941 0000064A B81900                      mov ax, 0x0019                 ; no extended fixed-disk type yet
   942 0000064D E871FF                      call cmos_write
   943 00000650 B82001                      mov ax, 0x0120                 ; OEM setup flags: boot Num Lock on, floppy first
   944 00000653 E86BFF                      call cmos_write
   945 00000656 B83000                      mov ax, 0x0030                 ; POST fills discovered extended memory
   946 00000659 E865FF                      call cmos_write
   947 0000065C B83100                      mov ax, 0x0031
   948 0000065F E85FFF                      call cmos_write
   949 00000662 E88CFF                      call cmos_write_checksum
   950 00000665 58                          pop ax
   951 00000666 C3                          ret
   952                                  
   953                                  ; Validate battery-backed configuration RAM and initialize RTC operating mode.
   954                                  cmos_validate_or_default:
   955 00000667 50                          push ax
   956 00000668 53                          push bx
   957 00000669 52                          push dx
   958 0000066A B00D                        mov al, 0x0D
   959 0000066C E849FF                      call cmos_read
   960 0000066F A880                        test al, 0x80                  ; register D valid-RAM bit
   961 00000671 7425                        jz .defaults
   962                                  
   963 00000673 E862FF                      call cmos_compute_checksum
   964 00000676 B02E                        mov al, 0x2E
   965 00000678 E83DFF                      call cmos_read
   966 0000067B 88C6                        mov dh, al
   967 0000067D B02F                        mov al, 0x2F
   968 0000067F E836FF                      call cmos_read
   969 00000682 88C2                        mov dl, al
   970 00000684 39D3                        cmp bx, dx
   971 00000686 7510                        jne .defaults
   972                                  
   973 00000688 B00E                        mov al, 0x0E
   974 0000068A E82BFF                      call cmos_read
   975 0000068D 243F                        and al, 0x3F                  ; clear battery/checksum diagnostic flags
   976 0000068F 88C4                        mov ah, al
   977 00000691 B00E                        mov al, 0x0E
   978 00000693 E82BFF                      call cmos_write
   979 00000696 EB03                        jmp .mode
   980                                  .defaults:
   981 00000698 E86CFF                      call cmos_load_defaults
   982                                  .mode:
   983 0000069B B80A26                      mov ax, 0x260A
   984 0000069E E820FF                      call cmos_write
   985 000006A1 B80B02                      mov ax, 0x020B
   986 000006A4 E81AFF                      call cmos_write
   987 000006A7 B00C                        mov al, 0x0C                  ; reading C clears any stale IRQ8 source
   988 000006A9 E80CFF                      call cmos_read
   989 000006AC 5A                          pop dx
   990 000006AD 5B                          pop bx
   991 000006AE 58                          pop ax
   992 000006AF C3                          ret
   993                                  
   994                                  ; Reflect ATA master presence in the AMI extended drive-type convention:
   995                                  ; type F in byte 12h and user type 47 in byte 19h.
   996                                  cmos_sync_detected_hardware:
   997 000006B0 50                          push ax
   998 000006B1 1E                          push ds
   999 000006B2 B8C09F                      mov ax, EBDA_SEG
  1000 000006B5 8ED8                        mov ds, ax
  1001 000006B7 803EE80301                  cmp byte [HD_PRESENT], 1
  1002 000006BC 1F                          pop ds
  1003 000006BD 750E                        jne .absent
  1004 000006BF B812F0                      mov ax, 0xF012
  1005 000006C2 E8FCFE                      call cmos_write
  1006 000006C5 B8192F                      mov ax, 0x2F19                 ; decimal 47
  1007 000006C8 E8F6FE                      call cmos_write
  1008 000006CB EB0C                        jmp .checksum
  1009                                  .absent:
  1010 000006CD B81200                      mov ax, 0x0012
  1011 000006D0 E8EEFE                      call cmos_write
  1012 000006D3 B81900                      mov ax, 0x0019
  1013 000006D6 E8E8FE                      call cmos_write
  1014                                  .checksum:
  1015 000006D9 E815FF                      call cmos_write_checksum
  1016 000006DC 58                          pop ax
  1017 000006DD C3                          ret
  1018                                  
  1019                                  ; IRQ8 handler. Reading register C clears PF/AF/UF and releases the RTC IRQ.
  1020                                  int70:
  1021 000006DE 50                          push ax
  1022 000006DF B00C                        mov al, 0x0C
  1023 000006E1 E8D4FE                      call cmos_read
  1024 000006E4 B020                        mov al, 0x20
  1025 000006E6 E6A0                        out 0xA0, al
  1026 000006E8 E620                        out 0x20, al
  1027 000006EA 58                          pop ax
  1028 000006EB CF                          iret
  1029                                  
  1030                                  ; CROMWELL KEYBOARD REALITY BRICK 2 BEGIN
  1031                                  ; ---------------------------------------------------------------------------
  1032                                  ; Cromwell Technologies AT enhanced-keyboard BIOS
  1033                                  ; Real 8042/keyboard transport.  IRQ1 consumes translated Set-1 bytes only.
  1034                                  ; ---------------------------------------------------------------------------
  1035                                  %define BDA_KBD_FLAGS1       0x0017
  1036                                  %define BDA_KBD_FLAGS2       0x0018
  1037                                  %define BDA_ALT_NUMPAD       0x0019
  1038                                  %define BDA_KBD_HEAD         0x001A
  1039                                  %define BDA_KBD_TAIL         0x001C
  1040                                  %define BDA_BREAK_FLAG       0x0071
  1041                                  %define BDA_WARM_BOOT        0x0072
  1042                                  %define BDA_KBD_START        0x0080
  1043                                  %define BDA_KBD_END          0x0082
  1044                                  %define BDA_KBD_STATUS3      0x0096
  1045                                  %define BDA_KBD_STATUS4      0x0097
  1046                                  
  1047                                  ; Private keyboard workspace at the very end of the 1 KiB EBDA.  Current disk
  1048                                  ; workspace ends at 03E8h.  Keep these bytes private to firmware; applications
  1049                                  ; observe only standard BDA/INT 16h state.
  1050                                  ; CMOS Setup owns 03EAh-03F5h.  Keep the runtime keyboard state above it;
  1051                                  ; overlapping these areas corrupts typematic/E1/Alt-numpad state on Setup use.
  1052                                  %define KBW_TYPEMATIC        0x03F6
  1053                                  %define KBW_POWER_BAT_SEEN   0x03F7
  1054                                  %define KBW_E1_INDEX         0x03F8
  1055                                  %define KBW_ALT_NUM_ACTIVE   0x03F9
  1056                                  %define KBW_COMMAND_BUSY     0x03FA
  1057                                  %define KBW_LED_PENDING      0x03FB
  1058                                  %define KBW_COMMAND_BYTE     0x03FC
  1059                                  %define KBW_COMMAND_DATA     0x03FD
  1060                                  
  1061                                  ; Controller polling helpers -------------------------------------------------
  1062                                  kbc_wait_ibf_clear:
  1063 000006EC 51                          push cx
  1064 000006ED B9FFFF                      mov cx, 0xFFFF
  1065                                  .wait:
  1066 000006F0 E464                        in al, 0x64
  1067 000006F2 A802                        test al, 2
  1068 000006F4 7405                        jz short .ready
  1069 000006F6 E2F8                        loop .wait
  1070 000006F8 F9                          stc
  1071 000006F9 59                          pop cx
  1072 000006FA C3                          ret
  1073                                  .ready:
  1074 000006FB F8                          clc
  1075 000006FC 59                          pop cx
  1076 000006FD C3                          ret
  1077                                  
  1078                                  kbc_wait_obf_short:
  1079 000006FE 51                          push cx
  1080 000006FF 52                          push dx
  1081 00000700 BA0800                      mov dx, 8
  1082                                  .outer:
  1083 00000703 B9FFFF                      mov cx, 0xFFFF
  1084                                  .inner:
  1085 00000706 E464                        in al, 0x64
  1086 00000708 A801                        test al, 1
  1087 0000070A 7509                        jnz short .ready
  1088 0000070C E2F8                        loop .inner
  1089 0000070E 4A                          dec dx
  1090 0000070F 75F2                        jnz short .outer
  1091 00000711 F9                          stc
  1092 00000712 5A                          pop dx
  1093 00000713 59                          pop cx
  1094 00000714 C3                          ret
  1095                                  .ready:
  1096 00000715 F8                          clc
  1097 00000716 5A                          pop dx
  1098 00000717 59                          pop cx
  1099 00000718 C3                          ret
  1100                                  
  1101                                  kbc_wait_obf_long:
  1102 00000719 51                          push cx
  1103 0000071A 52                          push dx
  1104 0000071B BA5000                      mov dx, 80
  1105                                  .outer:
  1106 0000071E B9FFFF                      mov cx, 0xFFFF
  1107                                  .inner:
  1108 00000721 E464                        in al, 0x64
  1109 00000723 A801                        test al, 1
  1110 00000725 7509                        jnz short .ready
  1111 00000727 E2F8                        loop .inner
  1112 00000729 4A                          dec dx
  1113 0000072A 75F2                        jnz short .outer
  1114 0000072C F9                          stc
  1115 0000072D 5A                          pop dx
  1116 0000072E 59                          pop cx
  1117 0000072F C3                          ret
  1118                                  .ready:
  1119 00000730 F8                          clc
  1120 00000731 5A                          pop dx
  1121 00000732 59                          pop cx
  1122 00000733 C3                          ret
  1123                                  
  1124                                  ; AL = controller command.
  1125                                  kbc_write_command:
  1126 00000734 50                          push ax
  1127 00000735 E8B4FF                      call kbc_wait_ibf_clear
  1128 00000738 7205                        jc short .fail
  1129 0000073A 58                          pop ax
  1130 0000073B E664                        out 0x64, al
  1131 0000073D F8                          clc
  1132 0000073E C3                          ret
  1133                                  .fail:
  1134 0000073F 58                          pop ax
  1135 00000740 F9                          stc
  1136 00000741 C3                          ret
  1137                                  
  1138                                  ; AL = byte for port 60h (controller parameter or keyboard byte).
  1139                                  kbc_write_data:
  1140 00000742 50                          push ax
  1141 00000743 E8A6FF                      call kbc_wait_ibf_clear
  1142 00000746 7205                        jc short .fail
  1143 00000748 58                          pop ax
  1144 00000749 E660                        out 0x60, al
  1145 0000074B F8                          clc
  1146 0000074C C3                          ret
