  1146 0000079B E86BFF                      call cmos_write
  1147 0000079E B83000                      mov ax, 0x0030                 ; POST fills discovered extended memory
  1148 000007A1 E865FF                      call cmos_write
  1149 000007A4 B83100                      mov ax, 0x0031
  1150 000007A7 E85FFF                      call cmos_write
  1151 000007AA E88CFF                      call cmos_write_checksum
  1152 000007AD 58                          pop ax
  1153 000007AE C3                          ret
