  1647 00000ADA B203                        mov dl, 3
  1648                                  .retry:
  1649 00000ADC 80269700CF                  and byte [BDA_KBD_STATUS4], 0xCF     ; clear ACK/RESEND observations
  1650 00000AE1 88D8                        mov al, bl
  1651 00000AE3 E8B9FD                      call kbc_write_data
  1652 00000AE6 7238                        jc short .failed
  1653                                  .wait:
  1654                                      ; With IRQ1 enabled the interrupt handler may consume FAh/FEh before this
  1655                                      ; foreground command path observes port 64h.  INT 09h records that physical
  1656                                      ; response in BDA_KBD_STATUS4.  Honor the ISR-owned observation both before
  1657                                      ; and after the bounded OBF wait; otherwise a successful EDh can time out
  1658                                      ; after its ACK and leave the real keyboard waiting for its parameter with
  1659                                      ; scanning suspended.  Do not CLI around the transaction: an edge-triggered
  1660                                      ; IRQ1 would remain pending after a polled read and deliver a false empty-OBF
  1661                                      ; interrupt when FLAGS were restored.
  1662 00000AE8 F606970010                  test byte [BDA_KBD_STATUS4], 0x10
  1663 00000AED 753B                        jnz short .acked
  1664 00000AEF F606970020                  test byte [BDA_KBD_STATUS4], 0x20
  1665 00000AF4 7521                        jnz short .resend
  1666 00000AF6 E862FD                      call kbc_wait_obf_short
  1667 00000AF9 7310                        jnc short .read_response
  1668 00000AFB F606970010                  test byte [BDA_KBD_STATUS4], 0x10
  1669 00000B00 7528                        jnz short .acked
  1670 00000B02 F606970020                  test byte [BDA_KBD_STATUS4], 0x20
  1671 00000B07 750E                        jnz short .resend
  1672 00000B09 EB15                        jmp short .failed
  1673                                  .read_response:
  1674 00000B0B E460                        in al, 0x60
  1675 00000B0D 3CFA                        cmp al, 0xFA
  1676 00000B0F 7419                        je short .acked
  1677 00000B11 3CFE                        cmp al, 0xFE
  1678 00000B13 7402                        je short .resend
  1679                                      ; During ED/F3/F0 parameter transactions scanning is suspended by the
  1680                                      ; keyboard itself.  A stray byte here is stale pre-command input; consume
  1681                                      ; it rather than mistaking it for protocol acknowledgement.
  1682 00000B15 EBD1                        jmp short .wait
  1683                                  .resend:
  1684 00000B17 800E970020                  or byte [BDA_KBD_STATUS4], 0x20
  1685 00000B1C FECA                        dec dl
  1686 00000B1E 75BC                        jnz short .retry
  1687                                  .failed:
  1688 00000B20 800E970080                  or byte [BDA_KBD_STATUS4], 0x80
  1689 00000B25 F9                          stc
