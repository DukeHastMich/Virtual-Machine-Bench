   983 0000069B B0B6                        mov al, 0xB6                    ; PIT2, lobyte/hibyte, mode 3 square wave
   984 0000069D E643                        out 0x43, al
   985 0000069F B8A904                      mov ax, 1193                    ; approximately 1 kHz from 1.193182 MHz PIT
   986 000006A2 E642                        out 0x42, al
   987 000006A4 88E0                        mov al, ah
   988 000006A6 E642                        out 0x42, al
   989 000006A8 88D8                        mov al, bl
   990 000006AA 0C03                        or al, 0x03                     ; gate PIT2 and connect it to speaker data
   991 000006AC E661                        out 0x61, al
   992 000006AE E461                        in al, 0x61
   993 000006B0 2420                        and al, 0x20
   994 000006B2 88C2                        mov dl, al
   995 000006B4 BE5000                      mov si, 80                      ; 80 half-cycles ~= 40 ms at 1 kHz
   996                                  .edge:
   997 000006B7 B9FFFF                      mov cx, 0xFFFF                  ; bounded safety timeout per transition
   998                                  .wait:
   999 000006BA E461                        in al, 0x61
  1000 000006BC 2420                        and al, 0x20
  1001 000006BE 38D0                        cmp al, dl
  1002 000006C0 7504                        jne short .changed
  1003 000006C2 E2F6                        loop .wait
  1004 000006C4 EB05                        jmp short .finish
  1005                                  .changed:
  1006 000006C6 88C2                        mov dl, al
  1007 000006C8 4E                          dec si
  1008 000006C9 75EC                        jnz short .edge
  1009                                  .finish:
  1010 000006CB 88D8                        mov al, bl
  1011 000006CD E661                        out 0x61, al                    ; restore gate/data/error-enable bits exactly
  1012 000006CF 5E                          pop si
  1013 000006D0 5A                          pop dx
  1014 000006D1 59                          pop cx
  1015 000006D2 5B                          pop bx
  1016 000006D3 58                          pop ax
  1017 000006D4 C3                          ret
