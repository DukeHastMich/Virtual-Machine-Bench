  1249 000007D4 C606180000                  mov byte [BDA_KBD_FLAGS2], 0
  1250 000007D9 C606190000                  mov byte [BDA_ALT_NUMPAD], 0
  1251 000007DE C7061A001E00                mov word [BDA_KBD_HEAD], 0x001E
  1252 000007E4 C7061C001E00                mov word [BDA_KBD_TAIL], 0x001E
  1253 000007EA C606710000                  mov byte [BDA_BREAK_FLAG], 0
  1254 000007EF C70680001E00                mov word [BDA_KBD_START], 0x001E
  1255 000007F5 C70682003E00                mov word [BDA_KBD_END], 0x003E
  1256 000007FB C606960000                  mov byte [BDA_KBD_STATUS3], 0
  1257 00000800 C606970000                  mov byte [BDA_KBD_STATUS4], 0
  1258                                  
  1259 00000805 B8C09F                      mov ax, EBDA_SEG
  1260 00000808 8EC0                        mov es, ax
  1261 0000080A 26C606F6032B                mov byte [es:KBW_TYPEMATIC], 0x2B
  1262 00000810 26C606F70300                mov byte [es:KBW_POWER_BAT_SEEN], 0
  1263 00000816 26C606F80300                mov byte [es:KBW_E1_INDEX], 0
  1264 0000081C 26C606F90300                mov byte [es:KBW_ALT_NUM_ACTIVE], 0
  1265 00000822 26C606FA0300                mov byte [es:KBW_COMMAND_BUSY], 0
  1266 00000828 26C606FB0300                mov byte [es:KBW_LED_PENDING], 0
  1267 0000082E 26C606FE0380                mov byte [es:KBW_POST_RESULT], 0x80 ; controller/self-test stage
  1268                                  
  1269 00000834 B021                        mov al, 0x21
