     1                                  ; Diamond Stealth Pro ISA revision C5 clean-room VGA option ROM
     2                                  ; S3 86C928, 2 MiB 60 ns VRAM, Brooktree Bt485, 16-bit ISA profile
     3                                  ;
     4                                  ; 32 KiB option ROM mapped at C0000h.  The system BIOS validates the 55AAh
     5                                  ; header/checksum, calls entry point +3, and the card installs INT 10h.
     6                                  ;
     7                                  ; This ROM deliberately exposes standard VGA services and leaves extended
     8                                  ; SVGA mode selection to S3/Diamond drivers, just as period software could
     9                                  ; program the 86C928 enhanced register interface directly.
    10                                  
    11                                  bits 16
    12                                  org 0
    13                                  cpu 286
    14                                  
    15                                  %define BDA_SEG   0x0040
    16                                  %define TEXT_SEG  0xB800
    17                                  %define VGA_SEG   0xA000
    18                                  
    19                                  %macro J286_E 1
    20                                      jne short %%skip
    21                                      jmp %1
    22                                  %%skip:
    23                                  %endmacro
    24                                  %macro J286_NE 1
    25                                      je short %%skip
    26                                      jmp %1
    27                                  %%skip:
    28                                  %endmacro
    29                                  %macro J286_B 1
    30                                      jae short %%skip
    31                                      jmp %1
    32                                  %%skip:
    33                                  %endmacro
    34                                  %macro J286_AE 1
    35                                      jb short %%skip
    36                                      jmp %1
    37                                  %%skip:
    38                                  %endmacro
    39                                  %macro J286_BE 1
    40                                      ja short %%skip
    41                                      jmp %1
    42                                  %%skip:
    43                                  %endmacro
