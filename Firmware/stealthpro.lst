    62 00000E24 26A28900            <1>     mov [es:0x89], al
    63 00000E28 26C6068A0000        <1>     mov byte [es:0x8A], 0          ; first DCC-table entry = VGA color
    64                              <1> 
    65 00000E2E 80FA04              <1>     cmp dl, 0x04
    66 00000E31 7220                <1>     jb .text_16
    67 00000E33 80FA06              <1>     cmp dl, 0x06
    68 00000E36 762A                <1>     jbe .graphics_8
    69 00000E38 80FA07              <1>     cmp dl, 0x07
    70 00000E3B 7416                <1>     je .text_16
    71 00000E3D 80FA0D              <1>     cmp dl, 0x0D
    72 00000E40 7420                <1>     je .graphics_8
    73 00000E42 80FA0E              <1>     cmp dl, 0x0E
    74 00000E45 741B                <1>     je .graphics_8
