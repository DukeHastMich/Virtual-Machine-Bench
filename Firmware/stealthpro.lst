   516                                  
   517 00000448 BAC203                      mov dx, 0x3C2
   518 0000044B AC                          lodsb
   519 0000044C EE                          out dx, al
   520                                  
   521                                      ; Sequencer reset/program/run.
   522 0000044D BAC403                      mov dx, 0x3C4
   523 00000450 31DB                        xor bx, bx
