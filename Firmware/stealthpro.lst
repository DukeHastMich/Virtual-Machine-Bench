    28                              <1> ; Refresh the extended VGA BDA fields which are common to all modes currently
    29                              <1> ; exposed by this ROM.  DL=current mode, BL=original mode request (bit7=no clear).
    30                              <1> vga_update_extended_bda:
    31 00000DF6 50                  <1>     push ax
    32 00000DF7 06                  <1>     push es
    33 00000DF8 B84000              <1>     mov ax, BDA_SEG
    34 00000DFB 8EC0                <1>     mov es, ax
    35                              <1> 
    36                              <1>     ; 0040:0087 - EGA/VGA video control.  Bits 6:5=11b denotes the standard
    37                              <1>     ; 256-KiB-or-more VGA memory class.  Bit7 records the no-clear mode request.
    38 00000DFD B060                <1>     mov al, 0x60
    39 00000DFF F6C380              <1>     test bl, 0x80
    40 00000E02 7402                <1>     jz .have_no_clear
