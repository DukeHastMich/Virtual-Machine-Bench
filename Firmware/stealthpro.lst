   102                              <1> ; ---------------------------------------------------------------------------
   103                              <1> ; INT 10h AH=11h - character-generator services.
   104                              <1> ;
   105                              <1> ; Supported here:
   106                              <1> ;   AL=00h  user alpha load (mode reset, regen buffer preserved)
   107                              <1> ;   AL=03h  character-map block select
   108                              <1> ;   AL=04h  load built-in 8x16 alpha font
   109                              <1> ;   AL=10h  user alpha load after mode set + text-metric recalculation
   110                              <1> ;   AL=14h  load built-in 8x16 alpha font + text-metric recalculation
   111                              <1> ;   AL=20h  set INT 1Fh user graphics-font pointer
   112                              <1> ;   AL=21h  set INT 43h graphics-font pointer and row/point metadata
   113                              <1> ;   AL=24h  select built-in 8x16 graphics font
   114                              <1> ;   AL=30h  return current/user or built-in 8x16 font information
   115                              <1> ; ---------------------------------------------------------------------------
