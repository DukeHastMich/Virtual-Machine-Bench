    22 00000DE9 26C706A800[2B19]    <1>     mov word [es:0xA8], video_save_pointer_table
    22          ******************  <1>  warning: 16-bit absolute section-crossing relocation [-w+reloc-abs-word]
    23 00000DF0 268C0EAA00          <1>     mov word [es:0xAA], cs
    24 00000DF5 07                  <1>     pop es
    25 00000DF6 58                  <1>     pop ax
    26 00000DF7 C3                  <1>     ret
    27                              <1> 
    28                              <1> ; Refresh the extended VGA BDA fields which are common to all modes currently
    29                              <1> ; exposed by this ROM.  DL=current mode, BL=original mode request (bit7=no clear).
    30                              <1> vga_update_extended_bda:
    31 00000DF8 50                  <1>     push ax
    32 00000DF9 06                  <1>     push es
    33 00000DFA B84000              <1>     mov ax, BDA_SEG
    34 00000DFD 8EC0                <1>     mov es, ax
    35                              <1> 
    36                              <1>     ; 0040:0087 - EGA/VGA video control.  Bits 6:5=11b denotes the standard
    37                              <1>     ; 256-KiB-or-more VGA memory class.  Bit7 records the no-clear mode request.
    38 00000DFF B060                <1>     mov al, 0x60
    39 00000E01 F6C380              <1>     test bl, 0x80
    40 00000E04 7402                <1>     jz .have_no_clear
    41 00000E06 0C80                <1>     or al, 0x80
    42                              <1> .have_no_clear:
    43 00000E08 26A28700            <1>     mov [es:0x87], al
    44                              <1> 
    45                              <1>     ; 0040:0088 - VGA color switch/configuration setting.
    46 00000E0C 26C606880009        <1>     mov byte [es:0x88], 0x09
    47                              <1> 
    48                              <1>     ; 0040:0089 - VGA display data.  Preserve only display-switching (bit6)
    49                              <1>     ; and the caller's default-palette policy (bit3).  This BIOS does not
    50                              <1>     ; advertise grayscale summing, monochrome emulation, or bit0 (reserved).
    51                              <1>     ; Bit 4 is the IBM VGA 400-scan-line text-mode flag.  It is not a generic
    52                              <1>     ; 200/350/400/480 enumeration; graphics and 350/480-line modes leave it 0.
    53 00000E12 26A08900            <1>     mov al, [es:0x89]
    54 00000E16 2448                <1>     and al, 0x48                    ; preserve bits 6 and 3 only
    55 00000E18 80FA03              <1>     cmp dl, 3
    56 00000E1B 7605                <1>     jbe .mark_400_line_text
    57 00000E1D 80FA07              <1>     cmp dl, 7
    58 00000E20 7502                <1>     jne .store_display_data
    59                              <1> .mark_400_line_text:
    60 00000E22 0C10                <1>     or al, 0x10
