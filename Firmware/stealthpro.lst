     1                              <1> ; ---------------------------------------------------------------------------
     2                              <1> ; IBM VGA state / alternate-service completion layer for the clean-room
     3                              <1> ; Diamond Stealth Pro / S3 86C928 option ROM.
     4                              <1> ;
     5                              <1> ; This file deliberately implements STANDARD VGA state only.  It does not
     6                              <1> ; claim to save undocumented Diamond/S3 extended registers.  Those belong in
     7                              <1> ; an explicitly documented OEM/VESA extension, not in IBM INT 10h/AH=1Ch.
     8                              <1> ; ---------------------------------------------------------------------------
     9                              <1> 
    10                              <1> %define VGA_HW_STATE_SIZE   0x46
    11                              <1> %define VGA_BDA_STATE_SIZE  0x60      ; 0040:0049 through 0040:00A8 inclusive
    12                              <1> %define VGA_DAC_STATE_SIZE  0x304
