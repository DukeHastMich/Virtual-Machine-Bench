    45                                  ; Standard expansion-ROM header.  64 x 512-byte blocks = 32 KiB.
    46 00000000 55AA40                  db 0x55, 0xAA, 64
    47 00000003 EB3E                    jmp rom_init
    48                                  
    49 00000005 4449414D4F4E442053-     db 'DIAMOND STEALTH PRO ISA REV C5 - S3 86C928 - 2MB VRAM - BT485',0
