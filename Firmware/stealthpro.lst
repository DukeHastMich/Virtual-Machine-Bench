   637 000004DE 42                          inc dx                          ; 3C9h DAC data
   638                                  
   639 000004DF BE[651E]                    mov si, ega64_dac_table
   639          ******************       warning: 16-bit absolute section-crossing relocation [-w+reloc-abs-word]
   640 000004E2 B9C000                      mov cx, 64*3
   641                                  .load:
   642 000004E5 AC                          lodsb
   643 000004E6 EE                          out dx, al
   644 000004E7 E2FC                        loop .load
   645                                  
   646 000004E9 1F                          pop ds
   647 000004EA 5E                          pop si
   648 000004EB 5A                          pop dx
   649 000004EC 59                          pop cx
   650 000004ED 58                          pop ax
   651 000004EE C3                          ret
   652                                  
   653                                  ; Mode 13h's defined BIOS state includes the complete 256-entry VGA palette,
   654                                  ; not merely the first 16/64 EGA-compatible entries.  Programs are free to
   655                                  ; replace it afterward through 3C8h/3C9h.
   656                                  load_vga256_dac:
   657 000004EF 50                          push ax
   658 000004F0 51                          push cx
   659 000004F1 52                          push dx
   660 000004F2 56                          push si
   661 000004F3 1E                          push ds
   662 000004F4 0E                          push cs
   663 000004F5 1F                          pop ds
   664                                  
   665 000004F6 BAC803                      mov dx, 0x3C8
   666 000004F9 30C0                        xor al, al
   667 000004FB EE                          out dx, al
   668 000004FC 42                          inc dx
   669 000004FD BE[3E22]                    mov si, default_vga_256_dac
   669          ******************       warning: 16-bit absolute section-crossing relocation [-w+reloc-abs-word]
   670 00000500 B90003                      mov cx, 256*3
   671                                  .load:
   672 00000503 AC                          lodsb
   673 00000504 EE                          out dx, al
   674 00000505 E2FC                        loop .load
   675                                  
   676 00000507 1F                          pop ds
   677 00000508 5E                          pop si
   678 00000509 5A                          pop dx
   679 0000050A 59                          pop cx
   680 0000050B 58                          pop ax
   681 0000050C C3                          ret
   682                                  
