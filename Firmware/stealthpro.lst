   689 00000514 F606890008                  test byte [0x89], 0x08
   690 00000519 1F                          pop ds
   691 0000051A 58                          pop ax
   692 0000051B 7503                        jnz .skip
   693 0000051D E8B1FF                      call load_ega64_dac
   694                                  .skip:
   695 00000520 C3                          ret
   696                                  
