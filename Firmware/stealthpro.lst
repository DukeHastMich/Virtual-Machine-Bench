    51                                  rom_init:
    52 00000043 50                          push ax
    53 00000044 53                          push bx
    54 00000045 52                          push dx
    55 00000046 1E                          push ds
    56 00000047 06                          push es
    57                                  
    58                                      ; Power-on defaults leave the ISA video subsystem asleep with normal
    59                                      ; address decode disabled.  PD8 is strapped high in this profile, so bit 4
    60                                      ; of 46E8h selects setup mode.  In setup, 0102h bit0 wakes the subsystem;
    61                                      ; returning bit4 low with bit3 high enters normal decoded operation.
    62 00000048 BAE846                      mov dx, 0x46E8
    63 0000004B B010                        mov al, 0x10
    64 0000004D EE                          out dx, al
    65 0000004E BA0201                      mov dx, 0x0102
    66 00000051 B001                        mov al, 1
    67 00000053 EE                          out dx, al
    68 00000054 BAE846                      mov dx, 0x46E8
    69 00000057 B008                        mov al, 0x08
    70 00000059 EE                          out dx, al
    71                                  
    72                                      ; Install our option-ROM video service vector through the guest IVT.
    73 0000005A 31C0                        xor ax, ax
    74 0000005C 8ED8                        mov ds, ax
    75 0000005E C7064000[A800]              mov word [0x10*4], int10
    75          ******************       warning: 16-bit absolute section-crossing relocation [-w+reloc-abs-word]
    76 00000064 8C0E4200                    mov word [0x10*4+2], cs
    77                                  
    78                                      ; A VGA/EGA-class adapter is encoded as display type 00b in equipment-word
    79                                      ; bits 4-5.  The system BIOS initially advertises CGA 80x25 until an option
    80                                      ; ROM claims the display.  Clear only those two display bits here, leaving
    81                                      ; floppy/FPU/other equipment flags untouched.
    82 00000068 B84000                      mov ax, BDA_SEG
    83 0000006B 8EC0                        mov es, ax
    84 0000006D 2683261000CF                and word [es:0x10], 0xFFCF
    85                                  
    86                                      ; Unlock documented S3 extended VGA/system registers and advertise/use the
    87                                      ; 16-bit VGA memory data path.  Enhanced drawing registers remain available
    88                                      ; to software, while the display starts in ordinary VGA compatibility mode.
    89 00000073 BAD403                      mov dx, 0x3D4
    90 00000076 B038                        mov al, 0x38
    91 00000078 EE                          out dx, al
    92 00000079 42                          inc dx
    93 0000007A B048                        mov al, 0x48
    94 0000007C EE                          out dx, al
    95 0000007D 4A                          dec dx
    96 0000007E B039                        mov al, 0x39
    97 00000080 EE                          out dx, al
    98 00000081 42                          inc dx
    99 00000082 B0A5                        mov al, 0xA5
