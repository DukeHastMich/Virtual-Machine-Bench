   532 0000045C FEC3                        inc bl
   533 0000045E E2F5                        loop .seq_loop
   534                                  
   535                                      ; Misc Output bit 0 selects the live CRTC decoder.  Mode 07h is the VGA
   536                                      ; monochrome-compatibility personality at 03B4h/03B5h; writing 03D4h after
   537                                      ; selecting that personality is electrically invisible on real hardware.
