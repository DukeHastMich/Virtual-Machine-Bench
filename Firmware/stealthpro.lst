   499                                      ; Blank scan-out before changing any clock, serializer, CRTC, or memory
   500                                      ; interpretation state.  Attribute Controller PAS=0 disconnects display
   501                                      ; memory from the DAC while retaining sync; otherwise the old visible page
   502                                      ; is briefly interpreted through each partially programmed new mode.
   503                                      ; IBM VGA/XGA Technical Reference, Attribute Controller Address Register,
   504                                      ; Palette Address Source bit (3C0h bit 5).
   505 00000433 BACC03                      mov dx, 0x3CC
   506 00000436 EC                          in al, dx
   507 00000437 A801                        test al, 1
   508 00000439 BADA03                      mov dx, 0x3DA
