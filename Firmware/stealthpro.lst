   110 00000091 EE                          out dx, al
   111 00000092 42                          inc dx
   112 00000093 B001                        mov al, 0x01
   113 00000095 EE                          out dx, al
   114                                  
   115                                      ; Power-on display personality: VGA 80x25 color text.
   116 00000096 31C0                        xor ax, ax
   117 00000098 31DB                        xor bx, bx
   118 0000009A B003                        mov al, 3
   119 0000009C E8B600                      call set_mode_internal
   120 0000009F E83E0D                      call vga_install_save_pointer
