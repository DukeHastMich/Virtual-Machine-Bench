   127 00000EA4 3C20                <1>     cmp al, 0x20
   128 00000EA6 746F                <1>     je .set_int1f
   129 00000EA8 3C21                <1>     cmp al, 0x21
   130 00000EAA 747D                <1>     je .set_int43
