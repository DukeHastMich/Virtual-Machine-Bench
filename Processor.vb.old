        Return 0 ' Not used on 80286
    End Function
    ' String instruction support (basic REP MOVSB)
    Public Sub ExecuteMOVSB(repPrefix As Boolean)
        Dim count As Integer = If(repPrefix, CX, 1)
        Dim direction As Integer = If((FLAGS And &H400) <> 0, -1, 1)
        For i = 1 To count
            Dim srcAddr As UInt32 = (CUInt(DS) << 4) + SI
            Dim dstAddr As UInt32 = (CUInt(ES) << 4) + DI
            Memory(dstAddr) = Memory(srcAddr)
            SI = CUShort((SI + direction) And &HFFFF)
            DI = CUShort((DI + direction) And &HFFFF)
            If Not repPrefix Then Exit For
        Next
        If repPrefix Then CX = CUShort((CX - count) And &HFFFF)
        Debug.Print("MOVSB " & If(repPrefix, "(REP) ", "") & "completed")
    End Sub

    ' IDT vector parsing stub
    Public Sub LoadIDTEntry(vector As Byte)
        Dim addr As UInt32 = vector * 4 ' 80286 real-mode style
        Dim offset As UInt16 = ReadWord(addr)
        Dim seg As UInt16 = ReadWord(addr + 2)
        Debug.Print("IDT Vector " & vector & " -> " & Hex(seg) & ":" & Hex(offset))
    End Sub
    ' Additional string instructions
    Public Sub ExecuteSTOSB(repPrefix As Boolean)
        Dim count As Integer = If(repPrefix, CX, 1)
        Dim direction As Integer = If((FLAGS And &H400) <> 0, -1, 1)
        For i = 1 To count
            Dim dstAddr As UInt32 = (CUInt(ES) << 4) + DI
            Memory(dstAddr) = CByte(AL)
            DI = CUShort((DI + direction) And &HFFFF)
            If Not repPrefix Then Exit For
        Next
        If repPrefix Then CX = CUShort((CX - count) And &HFFFF)
        Debug.Print("STOSB " & If(repPrefix, "(REP) ", "") & "completed")
    End Sub

    Public Sub ExecuteCMPSB(repPrefix As Boolean)
        Dim count As Integer = If(repPrefix, CX, 1)
        Dim direction As Integer = If((FLAGS And &H400) <> 0, -1, 1)
        For i = 1 To count
            Dim srcAddr As UInt32 = (CUInt(DS) << 4) + SI
            Dim dstAddr As UInt32 = (CUInt(ES) << 4) + DI
            Dim result As Integer = Memory(srcAddr) - Memory(dstAddr)
            UpdateFlagsForCompare(result)
            SI = CUShort((SI + direction) And &HFFFF)
            DI = CUShort((DI + direction) And &HFFFF)
            If Not repPrefix Then Exit For
        Next
        If repPrefix Then CX = CUShort((CX - count) And &HFFFF)
        Debug.Print("CMPSB " & If(repPrefix, "(REP) ", "") & "completed")
    End Sub

    Private Sub UpdateFlagsForCompare(result As Integer)
        FLAGS = FLAGS And Not (&H40 Or &H80 Or &H1 Or &H400) ' Clear ZF, SF, CF, DF
        If result = 0 Then FLAGS = FLAGS Or &H40 ' ZF
        If (result And &H80) <> 0 Then FLAGS = FLAGS Or &H80 ' SF
        If result < 0 Then FLAGS = FLAGS Or &H1 ' CF
    End Sub
