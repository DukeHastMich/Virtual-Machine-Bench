    ' Protected Mode Structures
    Private Structure Descriptor
        Public LimitLow As UInt16
        Public BaseLow As UInt16
        Public BaseMid As Byte
        Public Access As Byte
        Public Granularity As Byte
        Public BaseHigh As Byte
    End Structure

    Private GDT(255) As Descriptor
    Private GDTR_Limit As UInt16
    Private GDTR_Base As UInt32

    ' Load Global Descriptor Table Register (LGDT)
    Public Sub LGDT(limit As UInt16, base As UInt32)
        GDTR_Limit = limit
        GDTR_Base = base
        Debug.Print("LGDT loaded. Limit=" & limit & " Base=" & Hex(base))
    End Sub

    ' Segment Selector Loading (simplified)
    Public Sub LoadSegmentSelector(selector As UInt16, ByRef segBase As UInt16)
        Dim index As Integer = (selector >> 3)
        If index * 8 > GDTR_Limit Then
            Debug.Print("GP Fault: selector index out of GDT limit")
            Return
        End If
        Dim addr As UInt32 = GDTR_Base + CUInt(index * 8)
        Dim desc As Descriptor
        desc.LimitLow = ReadWord(addr)
        desc.BaseLow = ReadWord(addr + 2)
        desc.BaseMid = Memory(addr + 4)
        desc.Access = Memory(addr + 5)
        desc.Granularity = Memory(addr + 6)
        desc.BaseHigh = Memory(addr + 7)
        Dim fullBase As UInt32 = CUInt(desc.BaseLow) Or (CUInt(desc.BaseMid) << 16) Or (CUInt(desc.BaseHigh) << 24)
        segBase = CUShort((fullBase >> 4) And &HFFFF) ' segment base to selector for real-mode comp.
        Debug.Print("Segment loaded: Base=" & Hex(fullBase))
    End Sub

    ' Enable protected mode (sets PE bit in MSW simulated)
    Public Sub EnterProtectedMode()
        FLAGS = FLAGS Or &H1 ' PE = bit 0 of CR0 (simulated)
        Debug.Print("Protected mode enabled.")
    End Sub

    ' Placeholder for IDT / interrupt gates
    Public Sub LIDT(limit As UInt16, base As UInt32)
        Debug.Print("LIDT loaded. Limit=" & limit & " Base=" & Hex(base))
    End Sub

    ' Control register stubs
    Private CR0 As UInt32 = 0
    Public Sub SetCR0(value As UInt32)
        CR0 = value
        Debug.Print("CR0 set to " & Hex(CR0))
    End Sub

    Public Function GetCR0() As UInt32
        Return CR0
    End Function
    ' Segment Descriptor Translation and Privilege Checking
    Private Function TranslateSegment(selector As UInt16, offset As UInt16) As UInt32
        Dim index As Integer = (selector >> 3)
        If index * 8 > GDTR_Limit Then
            Throw New Exception("#GP: Selector index out of bounds")
        End If

        Dim addr As UInt32 = GDTR_Base + CUInt(index * 8)
        Dim desc As Descriptor
        desc.LimitLow = ReadWord(addr)
        desc.BaseLow = ReadWord(addr + 2)
        desc.BaseMid = Memory(addr + 4)
        desc.Access = Memory(addr + 5)
        desc.Granularity = Memory(addr + 6)
        desc.BaseHigh = Memory(addr + 7)

        Dim fullBase As UInt32 = CUInt(desc.BaseLow) Or (CUInt(desc.BaseMid) << 16) Or (CUInt(desc.BaseHigh) << 24)
        Dim limit As UInt32 = CUInt(desc.LimitLow) Or (CUInt(desc.Granularity And &HF) << 16)
        If (desc.Granularity And &H80) <> 0 Then limit = (limit << 12) Or &HFFF

        If offset > limit Then
            Throw New Exception("#GP: Offset beyond segment limit")
        End If

        Return fullBase + offset
    End Function

