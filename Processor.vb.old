    ' PIT (Programmable Interval Timer) Channel 0 Stub
    Public Sub PIT_Tick()
        ' Trigger timer IRQ (usually IRQ0 / INT 08h)
        RaiseInterrupt(&H8)
        Debug.Print("PIT Tick: INT 08h signaled")
    End Sub

    ' Programmable Interrupt Controller (PIC) IRQ Routing Stub
    Public Sub RaiseIRQ(irqNum As Byte)
        Dim intVec As Byte = irqNum + 8 ' PIC remapped offset
        RaiseInterrupt(intVec)
        Debug.Print("PIC IRQ" & irqNum & " routed to INT " & Hex(intVec) & "h")
    End Sub

    ' Keyboard Controller Stub
    Private KeyboardBuffer As New Queue(Of Byte)

    Public Sub KeyboardSendScanCode(scanCode As Byte)
        KeyboardBuffer.Enqueue(scanCode)
        RaiseIRQ(1) ' IRQ1 -> INT 09h
        Debug.Print("Keyboard scan code " & Hex(scanCode) & " enqueued")
    End Sub

    Public Function KeyboardRead() As Byte
        If KeyboardBuffer.Count > 0 Then
            Return KeyboardBuffer.Dequeue()
        Else
            Return 0
        End If
    End Function

    Public Function KeyboardHasKey() As Boolean
        Return KeyboardBuffer.Count > 0
    End Function


    ' FPU Stack and helpers
    Private FPUStack(7) As Double
    Private FPUPointer As Integer = 0

    Public Sub FPU_PUSH(value As Double)
        FPUPointer = (FPUPointer - 1) And 7
        FPUStack(FPUPointer) = value
        Debug.Print("FPU_PUSH " & value)
    End Sub

    Public Function FPU_POP() As Double
        Dim value As Double = FPUStack(FPUPointer)
        FPUPointer = (FPUPointer + 1) And 7
        Debug.Print("FPU_POP => " & value)
        Return value
    End Function

End Class
