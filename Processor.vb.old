    ' FAR CALL, JMP, and IRET support
    Public Sub CallFar(newCS As UInt16, newIP As UInt16)
        Push(CS)
        Push(IP)
        CS = newCS
        IP = newIP
        Debug.Print("CALL FAR to " & Hex(newCS) & ":" & Hex(newIP))
    End Sub

    Public Sub JmpFar(newCS As UInt16, newIP As UInt16)
        CS = newCS
        IP = newIP
        Debug.Print("JMP FAR to " & Hex(newCS) & ":" & Hex(newIP))
    End Sub

    Public Sub IRet()
        IP = Pop()
        CS = Pop()
        FLAGS = Pop()
        Debug.Print("IRET to " & Hex(CS) & ":" & Hex(IP))
    End Sub

