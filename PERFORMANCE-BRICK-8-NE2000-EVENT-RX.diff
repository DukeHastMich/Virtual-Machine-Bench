     Private Sub CloseUdpLocked()
-        ' Publish "cable absent" first.  Machine-thread fast paths may then stop
-        ' entering the host transport lock while this close completes.
-        Threading.Volatile.Write(_udpConnectedInBed, 0)
-
-        If _udp IsNot Nothing Then
-            Try : _udp.Close() : Catch : End Try
-        End If
+        ' Invalidate the old receive generation BEFORE closing the socket.  A
+        ' datagram that was already returning from the host kernel can therefore
+        ' never leak from an old tunnel into a newly configured virtual cable.
+        Volatile.Write(_udpConnectedInBed, 0)
+        Interlocked.Increment(_udpGenerationInBed)
+
+        Dim oldClientInBed As UdpClient = _udp
+        Dim oldThreadInBed As Thread = _udpReceiveThreadInBed
         _udp = Nothing
         _udpPeer = Nothing
+        _udpReceiveThreadInBed = Nothing
+
+        If oldClientInBed IsNot Nothing Then
+            Try
+                oldClientInBed.Close()
+            Catch
+            End Try
+        End If
+
+        ' Receive() is blocked in the host kernel and Close() wakes it.  The
+        ' worker never enters _sync, so joining here cannot deadlock the card.
+        If oldThreadInBed IsNot Nothing AndAlso
+           oldThreadInBed IsNot Thread.CurrentThread Then
+            oldThreadInBed.Join(500)
+        End If
+
+        ClearHostReceiveQueueInBed()
+    End Sub
+
+    Private Sub ClearHostReceiveQueueInBed()
+        Dim ignoredInBed As HostReceivedFrameInBed
+        While _hostReceiveQueueInBed.TryDequeue(ignoredInBed)
+            Interlocked.Decrement(_hostReceiveQueuedCountInBed)
+        End While
+        Interlocked.Exchange(_hostReceiveQueuedCountInBed, 0)
+    End Sub
+
+    Private Shared Function SameUdpEndpointInBed(leftInBed As IPEndPoint,
+                                                 rightInBed As IPEndPoint) As Boolean
+        If leftInBed Is Nothing OrElse rightInBed Is Nothing Then Return False
+        Return leftInBed.Port = rightInBed.Port AndAlso
+               leftInBed.Address.Equals(rightInBed.Address)
+    End Function
+
+    Private Sub UdpReceiveLoopInBed(stateInBed As UdpReceiveThreadStateInBed)
+        ' Blocking host receive is intentional: this thread sleeps in the kernel
+        ' until a frame arrives.  There is no guest-time 1-ms polling wake.
+        Try
+            While Volatile.Read(_disposed) = False AndAlso
+                  stateInBed.Generation = Volatile.Read(_udpGenerationInBed) AndAlso
+                  Volatile.Read(_udpConnectedInBed) <> 0
+
+                Dim sourceInBed As IPEndPoint = Nothing
+                Dim frameInBed As Byte()
+
+                Try
+                    frameInBed = stateInBed.Client.Receive(sourceInBed)
+                Catch ex As ObjectDisposedException
+                    Exit While
+                Catch ex As SocketException
+                    ' Closing/reconfiguring the tunnel interrupts Receive().
+                    If stateInBed.Generation <> Volatile.Read(_udpGenerationInBed) OrElse
+                       Volatile.Read(_udpConnectedInBed) = 0 Then
+                        Exit While
+                    End If
+                    If RuntimeDiagnostics.Enabled Then
+                        Interlocked.Increment(_hostReceiveQueueDropsInBed)
+                    End If
+                    Continue While
+                Catch
+                    If stateInBed.Generation <> Volatile.Read(_udpGenerationInBed) OrElse
+                       Volatile.Read(_udpConnectedInBed) = 0 Then
+                        Exit While
+                    End If
+                    If RuntimeDiagnostics.Enabled Then
+                        Interlocked.Increment(_hostReceiveQueueDropsInBed)
+                    End If
+                    Continue While
+                End Try
+
+                If frameInBed Is Nothing Then Continue While
+
+                ' Tunnel peer filtering belongs on the HOST side of the card
+                ' boundary.  A packet from any other UDP endpoint is not a frame
+                ' that arrived on this configured virtual Ethernet cable.
+                If Not SameUdpEndpointInBed(sourceInBed, stateInBed.Peer) Then
+                    If RuntimeDiagnostics.Enabled Then
+                        Interlocked.Increment(_hostReceiveQueueDropsInBed)
+                    End If
+                    Continue While
+                End If
+
+                If stateInBed.Generation <> Volatile.Read(_udpGenerationInBed) Then
+                    Exit While
+                End If
+
+                Dim queuedInBed As Integer =
+                    Interlocked.Increment(_hostReceiveQueuedCountInBed)
+                If queuedInBed > HostReceiveQueueCapacityInBed Then
+                    Interlocked.Decrement(_hostReceiveQueuedCountInBed)
+                    If RuntimeDiagnostics.Enabled Then
+                        Interlocked.Increment(_hostReceiveQueueDropsInBed)
+                    End If
+                    Continue While
+                End If
+
+                _hostReceiveQueueInBed.Enqueue(
+                    New HostReceivedFrameInBed With {
+                        .Generation = stateInBed.Generation,
+                        .Frame = frameInBed
+                    })
+            End While
+        Catch
+            ' Host transport failure must not kill the virtual machine thread.
+            If RuntimeDiagnostics.Enabled Then
+                Interlocked.Increment(_hostReceiveQueueDropsInBed)
+            End If
+        End Try
     End Sub
 
