10 DEFINT A-Z
20 P=&H220
30 DIM F(7)

40 REM --- NOTE TABLE ---
50 F(1)=&H159
60 F(2)=&H183
70 F(3)=&H1B3
80 F(4)=&H1CC
90 F(5)=&H205
100 F(6)=&H244
110 F(7)=&H28B

120 GOSUB 500
130 PRINT "ODE TO JOY - OPL TEST"
135 RESTORE 300

140 FOR N=1 TO 30
150 READ NT,DU
160 GOSUB 800
170 NEXT N

180 OUT P,&HB0:OUT P+1,0
190 PRINT "DONE"
200 END

300 DATA 3,2,3,2,4,2,5,2
310 DATA 5,2,4,2,3,2,2,2
320 DATA 1,2,1,2,2,2,3,2
330 DATA 3,3,2,1,2,4
340 DATA 3,2,3,2,4,2,5,2
350 DATA 5,2,4,2,3,2,2,2
360 DATA 1,2,1,2,2,2,3,2
370 DATA 2,3,1,1,1,4

500 REM --- CLEAN OPL VOICE ---

510 OUT P,&H20:OUT P+1,&H21
520 OUT P,&H23:OUT P+1,&H21

530 REM MODULATOR QUIET
540 OUT P,&H40:OUT P+1,&H38

550 REM CARRIER LOUD
560 OUT P,&H43:OUT P+1,&H00

570 REM FAST ATTACK / SLOW DECAY
580 OUT P,&H60:OUT P+1,&HF2
590 OUT P,&H63:OUT P+1,&HF2

600 REM SUSTAIN / RELEASE
610 OUT P,&H80:OUT P+1,&H24
620 OUT P,&H83:OUT P+1,&H14

630 REM SINE WAVES
640 OUT P,&HE0:OUT P+1,0
650 OUT P,&HE3:OUT P+1,0

660 REM NO FEEDBACK - FM CONNECTION
670 OUT P,&HC0:OUT P+1,0

680 RETURN

800 REM --- PLAY ONE NOTE ---

810 REM KEY OFF PREVIOUS NOTE
820 OUT P,&HB0:OUT P+1,0

830 REM SHORT REAL-TIME GAP
840 T!=TIMER
850 IF TIMER<T!+.055 THEN 850

860 FV=F(NT)
870 LO=FV AND &HFF
880 HI=(FV\256) AND 3

890 REM BLOCK 4 + KEY ON
900 BH=HI OR &H30

910 OUT P,&HA0:OUT P+1,LO
920 OUT P,&HB0:OUT P+1,BH

930 REM NOTE DURATION
940 T!=TIMER
950 IF TIMER<T!+DU*.12 THEN 950

960 REM KEY OFF, RETAIN BLOCK/PITCH
970 OUT P,&HB0:OUT P+1,(HI OR &H10)

980 REM RELEASE GAP
990 T!=TIMER
1000 IF TIMER<T!+.06 THEN 1000

1010 RETURN

