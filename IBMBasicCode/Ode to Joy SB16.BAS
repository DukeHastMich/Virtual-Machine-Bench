10 DEFINT A-Z
20 P=&H220
30 DIM F(7)

40 REM --- YMF262 F-NUMBERS, BLOCK 4 ---
50 F(1)=&H159: REM C
60 F(2)=&H183: REM D
70 F(3)=&H1B3: REM E
80 F(4)=&H1CC: REM F
90 F(5)=&H205: REM G
100 F(6)=&H244: REM A
110 F(7)=&H28B: REM B

120 GOSUB 500
130 PRINT "ODE TO JOY - OPL3 TEST"
140 PRINT

150 FOR N=1 TO 32
160 READ NOTE,DUR
170 GOSUB 800
180 NEXT N

190 REM FINAL KEY OFF
200 OUT P,&HB0:OUT P+1,0
210 PRINT "DONE"
220 END

300 REM --- ODE TO JOY ---
310 DATA 3,2, 3,2, 4,2, 5,2
320 DATA 5,2, 4,2, 3,2, 2,2
330 DATA 1,2, 1,2, 2,2, 3,2
340 DATA 3,3, 2,1, 2,4

350 DATA 3,2, 3,2, 4,2, 5,2
360 DATA 5,2, 4,2, 3,2, 2,2
370 DATA 1,2, 1,2, 2,2, 3,2
380 DATA 2,3, 1,1, 1,4

500 REM =================================
510 REM CLEAN MELODIC OPL VOICE
520 REM =================================

530 REM MODULATOR - SUSTAIN, MULTIPLIER 1
540 OUT P,&H20:OUT P+1,&H21

550 REM CARRIER - SUSTAIN, MULTIPLIER 1
560 OUT P,&H23:OUT P+1,&H21

570 REM MODULATOR ALMOST SILENT
580 OUT P,&H40:OUT P+1,&H3F

590 REM CARRIER VOLUME
600 OUT P,&H43:OUT P+1,&H08

610 REM FAST ATTACK, GENTLE DECAY
620 OUT P,&H60:OUT P+1,&HF2
630 OUT P,&H63:OUT P+1,&HF2

640 REM HIGH SUSTAIN, SOFT RELEASE
650 OUT P,&H80:OUT P+1,&H15
660 OUT P,&H83:OUT P+1,&H15

670 REM SINE WAVEFORMS
680 OUT P,&HE0:OUT P+1,0
690 OUT P,&HE3:OUT P+1,0

700 REM NO FEEDBACK, NORMAL 2-OP FM
710 OUT P,&HC0:OUT P+1,0
720 RETURN

800 REM =================================
810 REM PLAY NOTE
820 REM NOTE = 1..7, DUR = LENGTH
830 REM =================================

840 REM KEY OFF PREVIOUS NOTE
850 OUT P,&HB0:OUT P+1,0
860 FOR Q=1 TO 80:NEXT Q

870 FV=F(NOTE)
880 LO=FV AND &HFF
890 HI=(FV\256) AND 3

900 REM BLOCK 4 + KEY ON
910 BH=HI OR &H30

920 OUT P,&HA0:OUT P+1,LO
930 OUT P,&HB0:OUT P+1,BH
940 REM NOTE LENGTH
950 FOR Q=1 TO DUR*550:NEXT Q

960 REM KEY OFF, RETAIN PITCH/BLOCK
970 OUT P,&HB0:OUT P+1,(HI OR &H10)

980 REM ALLOW RELEASE TO BE HEARD
990 FOR Q=1 TO 100:NEXT Q
1000 RETURN
run