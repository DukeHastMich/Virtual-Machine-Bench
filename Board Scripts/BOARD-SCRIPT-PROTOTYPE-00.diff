diff -ruN "foxsrc/Board Scripts/VALIDATE-BOARD-SCRIPT-PROTOTYPE.py" "work/full/Board Scripts/VALIDATE-BOARD-SCRIPT-PROTOTYPE.py"
--- "foxsrc/Board Scripts/VALIDATE-BOARD-SCRIPT-PROTOTYPE.py"	1970-01-01 00:00:00.000000000 +0000
+++ "work/full/Board Scripts/VALIDATE-BOARD-SCRIPT-PROTOTYPE.py"	2026-09-11 00:29:35.492294007 +0000
@@ -0,0 +1,208 @@
+#!/usr/bin/env python3
+"""Source-level conformance check for VMB Board Script prototype 0.
+
+This does not replace a VB.NET compile.  It independently checks the grammar
+specimens, metadata integrity, expected negative test, project inclusion, and a
+small set of source-structure invariants in environments without dotnet.
+"""
+from __future__ import annotations
+import json, re, sys
+from pathlib import Path
+import xml.etree.ElementTree as ET
+
+ROOT = Path(__file__).resolve().parents[1]
+TOK = re.compile(r'''\s*(?:(?P<comment>\#.*|//.*)|(?P<string>"(?:\\.|[^"])*")|(?P<number>-?\d+(?:\.\d+)?)|(?P<ident>[A-Za-z_$][A-Za-z0-9_$-]*)|(?P<sym>[{}:.=;]))''')
+
+class ParseError(RuntimeError): pass
+
+def lex(text):
+    out=[]; pos=0
+    while pos < len(text):
+        if text[pos:].strip()=="": break
+        m=TOK.match(text,pos)
+        if not m:
+            line=text.count("\n",0,pos)+1
+            raise ParseError(f"unlexable input at line {line}: {text[pos:pos+20]!r}")
+        pos=m.end()
+        if m.group('comment'): continue
+        if m.group('string'):
+            out.append(('string', bytes(m.group('string')[1:-1], 'utf-8').decode('unicode_escape')))
+        elif m.group('number'): out.append(('number',m.group('number')))
+        elif m.group('ident'): out.append(('ident',m.group('ident')))
+        else: out.append((m.group('sym'),m.group('sym')))
+    out.append(('eof',''))
+    return out
+
+class Parser:
+    def __init__(self,text): self.t=lex(text); self.i=0
+    def cur(self): return self.t[self.i]
+    def eat(self,k,v=None):
+        t=self.cur()
+        if t[0]!=k or (v is not None and t[1].lower()!=v.lower()):
+            raise ParseError(f"expected {v or k}, got {t}")
+        self.i+=1; return t[1]
+    def kw(self,s): return self.eat('ident',s)
+    def ident(self): return self.eat('ident')
+    def num(self): return float(self.eat('number'))
+    def value(self):
+        k,v=self.cur()
+        if k=='string': self.i+=1; return v
+        if k=='number': self.i+=1; return float(v)
+        if k=='ident': self.i+=1; return {'true':True,'false':False}.get(v.lower(),v)
+        raise ParseError('expected value')
+    def parse(self):
+        self.kw('board'); b={'id':self.ident(),'title':None,'units':'mm','outline':None,'components':[],'nets':[]}; self.eat('{')
+        while self.cur()[0]!='}':
+            k=self.cur()[1].lower()
+            if k=='title': self.i+=1; b['title']=self.eat('string'); self.eat(';')
+            elif k=='units': self.i+=1; b['units']=self.ident(); self.eat(';')
+            elif k=='outline': self.i+=1; b['outline']=(self.num(),self.num()); self.eat(';')
+            elif k=='component': b['components'].append(self.component())
+            elif k=='net': b['nets'].append(self.net())
+            else: raise ParseError(f'unknown board statement {self.cur()}')
+        self.eat('}'); self.eat('eof'); return b
+    def component(self):
+        self.kw('component'); c={'ref':self.ident()}; self.eat(':'); c['part']=self.ident(); self.eat('{'); c['straps']={}; c['place']=None
+        while self.cur()[0]!='}':
+            k=self.cur()[1].lower()
+            if k=='place':
+                self.i+=1; x=self.num(); y=self.num(); self.kw('rot'); r=int(self.num()); self.kw('side'); side=self.ident(); self.eat(';'); c['place']=(x,y,r,side)
+            elif k=='strap':
+                self.i+=1; n=self.ident(); self.eat('='); c['straps'][n]=self.value(); self.eat(';')
+            else: raise ParseError(f'unknown component statement {self.cur()}')
+        self.eat('}'); return c
+    def net(self):
+        self.kw('net'); n={'name':self.ident(),'endpoints':[]}; self.eat('{')
+        while self.cur()[0]!='}':
+            self.kw('endpoint'); ref=self.ident(); self.eat('.'); pin=self.ident(); self.eat(';'); n['endpoints'].append((ref,pin))
+        self.eat('}'); return n
+
+def load_catalog():
+    parts={}; bindings={}
+    for p in ROOT.rglob('PARTS-METADATA.json'):
+        d=json.loads(p.read_text(encoding='utf-8-sig'))
+        for x in d.get('parts',[]):
+            if not x.get('id'): continue
+            if x['id'] in parts: raise AssertionError(f"duplicate part id {x['id']}")
+            parts[x['id']]={'data':x,'source':p}
+    for p in ROOT.rglob('WORKER-METADATA.json'):
+        d=json.loads(p.read_text(encoding='utf-8-sig'))
+        for x in d.get('bindings',[]):
+            pid=x['part_id']
+            if pid not in parts: raise AssertionError(f"worker metadata invents unknown part {pid}")
+            bindings[pid]={'data':x,'source':p}
+    return parts,bindings
+
+def validate(board,parts,bindings):
+    errors=[]
+    if board['units'].lower()!='mm': errors.append('units')
+    if not board['outline'] or min(board['outline'])<=0: errors.append('outline')
+    refs={}
+    for c in board['components']:
+        if c['ref'] in refs: errors.append('duplicate ref '+c['ref'])
+        refs[c['ref']]=c
+        if c['part'] not in parts: errors.append('unknown part '+c['part']); continue
+        if not c['place']: errors.append('missing placement '+c['ref']); continue
+        x,y,r,side=c['place']; w,h=board['outline']
+        if not (0<=x<=w and 0<=y<=h): errors.append('outside outline '+c['ref'])
+        if r%90: errors.append('rotation '+c['ref'])
+        if side.lower() not in ('top','bottom'): errors.append('side '+c['ref'])
+        if c['straps'] and c['part'] not in bindings: errors.append('straps without worker '+c['ref'])
+    netnames=set()
+    for n in board['nets']:
+        if n['name'] in netnames: errors.append('duplicate net '+n['name'])
+        netnames.add(n['name'])
+        if len(n['endpoints'])<2: errors.append('short net '+n['name'])
+        for ref,pin in n['endpoints']:
+            if ref not in refs: errors.append('unknown ref '+ref); continue
+            pid=refs[ref]['part']
+            if pid not in parts: continue
+            pinset={x['name'].lower() for x in bindings.get(pid,{}).get('data',{}).get('pins',[])}
+            if not pinset: errors.append(f'no pin metadata {ref}.{pin}')
+            elif pin.lower() not in pinset: errors.append(f'unknown pin {ref}.{pin}')
+    return errors
+
+def vb_balance(path):
+    text=path.read_text(encoding='utf-8-sig')
+    pairs=[('Class','End Class'),('Module','End Module'),('Structure','End Structure'),('Enum','End Enum'),('Interface','End Interface')]
+    failures=[]
+    for start_kw,end_kw in pairs:
+        a=len(re.findall(rf'^\s*(?:Public |Private |Friend |Protected |Shared |NotInheritable |MustInherit |Partial )*{start_kw}\b',text,re.M|re.I))
+        b=len(re.findall(rf'^\s*{re.escape(end_kw)}\b',text,re.M|re.I))
+        if a!=b: failures.append(f'{start_kw} {a}!={b}')
+    return failures
+
+def main():
+    parts,bindings=load_catalog()
+    good=['Octek-FOX-II-286-Rev3.2.bs','NEAT-CS8221-Reference.bs']
+    for name in good:
+        board=Parser((ROOT/'Board Scripts'/'Samples'/name).read_text()).parse()
+        errs=validate(board,parts,bindings)
+        if errs: raise AssertionError(f'{name} failed: {errs}')
+        print(f'PASS grammar/catalog: {name} ({len(board["components"])} components, {len(board["nets"])} nets)')
+    bad=Parser((ROOT/'Board Scripts'/'Samples'/'INVALID-Invented-Part-Must-Fail.bs').read_text()).parse()
+    errs=validate(bad,parts,bindings)
+    if not any(e.startswith('unknown part') for e in errs): raise AssertionError('negative invented-part test did not fail as required')
+    print('PASS negative test: invented part rejected')
+
+    # Exact sourced NEAT pins used by the sample must stay pinned to the captured PLCC84 numbers.
+    expected={
+      'ct-82c211':{'PROCCLK':2,'RESET4':38,'HLDA1':40,'PAR_ERR':11,'ACEN':47},
+      'ct-82c212':{'PROCCLK':83,'RESET4':12,'HLDA1':19,'DLE':45,'DRD':33},
+      'ct-82c215':{'HLDA1':53,'PAR_ERR':83,'ACEN':14,'DLE':76,'DRD':74},
+    }
+    for pid,pins in expected.items():
+        got={x['name']:x.get('number') for x in bindings[pid]['data']['pins']}
+        for name,num in pins.items():
+            if got.get(name)!=num: raise AssertionError(f'{pid}.{name} expected pin {num}, got {got.get(name)}')
+    print('PASS NEAT sourced pin subset')
+
+    # FOX HT12 script's current 4 MiB power-on straps must encode the same REG10
+    # value as Ht12PowerOnStraps.SystemConfigurationValue: 6 | 10h | (3 << 5) = 76h.
+    fox=Parser((ROOT/'Board Scripts'/'Samples'/'Octek-FOX-II-286-Rev3.2.bs').read_text()).parse()
+    ht12=next(c for c in fox['components'] if c['part']=='headland-ht12-a')
+    st=ht12['straps']
+    reg10=(int(st['RamConfigurationCode']) & 7)
+    if st['AtBusLowSpeed']: reg10 |= 0x08
+    if st['ZeroWaitMainMemory']: reg10 |= 0x10
+    reg10 |= (int(st['ExtraWaitStateMode']) & 3) << 5
+    if st['TcStrapHigh']: reg10 |= 0x80
+    if reg10 != 0x76: raise AssertionError(f'FOX HT12 REG10 expected 76h, got {reg10:02X}h')
+    print('PASS FOX HT12 strap encoding: REG10=76h')
+
+    # The split NEAT prototype starts from the same reset register values as the
+    # current green monolithic worker for the surfaces it owns.
+    live=(ROOT/'MotherboardDevices.vb').read_text(encoding='utf-8-sig')
+    split=(ROOT/'Hardware'/'Chipsets'/'Chips and Technologies'/'CS8221 NEAT'/'CtNeatBoardScriptWorkers.vb').read_text(encoding='utf-8-sig')
+    for text,label in [('_ra1 = &H45','live 82C211 REG61'),('_ra2 = &H18','live 82C211 REG62'),('_rb(1) = &HE','live 82C212 REG65'),('_rb(6) = &H80','live 82C212 REG6A'),('_rb(7) = &H6B','live 82C212 REG6B'),('_ipcConfiguration = &HC0','live 82C206 REG01')]:
+        if text not in live: raise AssertionError('missing '+label)
+    for text,label in [('_reg61 = &H45','split 82C211 REG61'),('_reg62 = &H18','split 82C211 REG62'),('_registers(1) = &HE','split 82C212 REG65'),('_registers(6) = &H80','split 82C212 REG6A'),('_registers(7) = &H6B','split 82C212 REG6B'),('_configuration = &HC0','split 82C206 REG01')]:
+        if text not in split: raise AssertionError('missing '+label)
+    print('PASS split NEAT reset-surface parity with live worker')
+
+    project=ET.parse(ROOT/'VirtualComputer.Modern.vbproj').getroot()
+    inc=[e.attrib.get('Include','') for e in project.iter() if e.tag.endswith('Compile')]
+    if len(inc)!=len(set(x.lower() for x in inc)): raise AssertionError('duplicate Compile entry')
+    required=[
+      r'Hardware\Board Script\BoardScriptModel.vb',r'Hardware\Board Script\BoardScriptLexer.vb',
+      r'Hardware\Board Script\BoardScriptParser.vb',r'Hardware\Board Script\BoardScriptCatalog.vb',
+      r'Hardware\Board Script\BoardScriptWorkers.vb',r'Hardware\Board Script\BoardScriptCompiler.vb',
+      r'Hardware\Board Script\BoardScriptCli.vb',r'Hardware\Chipsets\Headland\HT12\HeadlandHt12.vb',
+      r'Hardware\Chipsets\Chips and Technologies\CS8221 NEAT\CtNeatBoardScriptWorkers.vb']
+    missing=[x for x in required if x not in inc]
+    if missing: raise AssertionError(f'missing Compile entries: {missing}')
+    print(f'PASS project Compile list: {len(inc)} unique entries')
+
+    files=[ROOT/x.replace('\\','/') for x in required]
+    failures=[]
+    for p in files:
+        f=vb_balance(p)
+        if f: failures.append(f'{p.relative_to(ROOT)}: {f}')
+    if failures: raise AssertionError('VB structural balance failed: '+'; '.join(failures))
+    print('PASS coarse VB type/module block-balance scan')
+    print('NOTE no dotnet/MSBuild/VBC toolchain present; this is not a compile claim')
+
+if __name__=='__main__':
+    try: main()
+    except Exception as e:
+        print('FAIL:',e,file=sys.stderr); sys.exit(1)
diff -ruN "foxsrc/Hardware/Board Script/BoardScriptCatalog.vb" "work/full/Hardware/Board Script/BoardScriptCatalog.vb"
--- "foxsrc/Hardware/Board Script/BoardScriptCatalog.vb"	1970-01-01 00:00:00.000000000 +0000
+++ "work/full/Hardware/Board Script/BoardScriptCatalog.vb"	2026-09-11 00:28:26.984972496 +0000
@@ -0,0 +1,116 @@
+Imports System
+Imports System.Collections.Generic
+Imports System.IO
+Imports System.Text.Json
+
+Public NotInheritable Class BoardScriptPartCatalog
+    Private ReadOnly _parts As New Dictionary(Of String, BoardScriptPartMetadata)(StringComparer.OrdinalIgnoreCase)
+
+    Public ReadOnly Property Parts As IReadOnlyDictionary(Of String, BoardScriptPartMetadata)
+        Get
+            Return _parts
+        End Get
+    End Property
+
+    Public Shared Function LoadTree(rootPathInBed As String) As BoardScriptPartCatalog
+        If String.IsNullOrWhiteSpace(rootPathInBed) Then Throw New ArgumentNullException(NameOf(rootPathInBed))
+        If Not Directory.Exists(rootPathInBed) Then Throw New DirectoryNotFoundException(rootPathInBed)
+
+        Dim catalogInBed As New BoardScriptPartCatalog()
+        For Each pathInBed As String In Directory.EnumerateFiles(rootPathInBed, "PARTS-METADATA.json", SearchOption.AllDirectories)
+            catalogInBed.LoadPartsMetadata(pathInBed)
+        Next
+        For Each pathInBed As String In Directory.EnumerateFiles(rootPathInBed, "WORKER-METADATA.json", SearchOption.AllDirectories)
+            catalogInBed.LoadWorkerMetadata(pathInBed)
+        Next
+        Return catalogInBed
+    End Function
+
+    Public Function TryGetPart(partIdInBed As String, ByRef metadataInBed As BoardScriptPartMetadata) As Boolean
+        Return _parts.TryGetValue(partIdInBed, metadataInBed)
+    End Function
+
+    Private Sub LoadPartsMetadata(pathInBed As String)
+        Using documentInBed As JsonDocument = JsonDocument.Parse(File.ReadAllText(pathInBed))
+            Dim partsElementInBed As JsonElement
+            If Not documentInBed.RootElement.TryGetProperty("parts", partsElementInBed) OrElse partsElementInBed.ValueKind <> JsonValueKind.Array Then Return
+
+            For Each partElementInBed As JsonElement In partsElementInBed.EnumerateArray()
+                Dim idInBed As String = ReadString(partElementInBed, "id")
+                If String.IsNullOrWhiteSpace(idInBed) Then Continue For
+                Dim metadataInBed As BoardScriptPartMetadata = Nothing
+                If Not _parts.TryGetValue(idInBed, metadataInBed) Then
+                    metadataInBed = New BoardScriptPartMetadata With {.PartId = idInBed}
+                    _parts.Add(idInBed, metadataInBed)
+                ElseIf Not String.IsNullOrWhiteSpace(metadataInBed.PartsMetadataSource) AndAlso
+                       Not String.Equals(metadataInBed.PartsMetadataSource, pathInBed, StringComparison.OrdinalIgnoreCase) Then
+                    Throw New InvalidDataException("Duplicate physical part id '" & idInBed & "' appears in both '" & metadataInBed.PartsMetadataSource & "' and '" & pathInBed & "'.")
+                End If
+                metadataInBed.Manufacturer = ReadString(partElementInBed, "manufacturer")
+                metadataInBed.PartNumber = ReadString(partElementInBed, "part_number")
+                metadataInBed.Package = ReadString(partElementInBed, "package")
+                metadataInBed.Role = ReadString(partElementInBed, "role")
+                metadataInBed.PartsMetadataSource = pathInBed
+            Next
+        End Using
+    End Sub
+
+    Private Sub LoadWorkerMetadata(pathInBed As String)
+        Using documentInBed As JsonDocument = JsonDocument.Parse(File.ReadAllText(pathInBed))
+            Dim bindingsInBed As JsonElement
+            If Not documentInBed.RootElement.TryGetProperty("bindings", bindingsInBed) OrElse bindingsInBed.ValueKind <> JsonValueKind.Array Then Return
+
+            For Each bindingInBed As JsonElement In bindingsInBed.EnumerateArray()
+                Dim partIdInBed As String = ReadString(bindingInBed, "part_id")
+                If String.IsNullOrWhiteSpace(partIdInBed) Then Continue For
+                Dim metadataInBed As BoardScriptPartMetadata = Nothing
+                If Not _parts.TryGetValue(partIdInBed, metadataInBed) Then
+                    Throw New InvalidDataException("Worker metadata '" & pathInBed & "' references unknown part '" & partIdInBed & "'. A behavior binding cannot create a physical part identity.")
+                End If
+                If Not String.IsNullOrWhiteSpace(metadataInBed.WorkerMetadataSource) AndAlso
+                   Not String.Equals(metadataInBed.WorkerMetadataSource, pathInBed, StringComparison.OrdinalIgnoreCase) Then
+                    Throw New InvalidDataException("Duplicate worker binding for part '" & partIdInBed & "' appears in both '" & metadataInBed.WorkerMetadataSource & "' and '" & pathInBed & "'.")
+                End If
+                metadataInBed.WorkerId = ReadString(bindingInBed, "worker_id")
+                metadataInBed.PhysicalPinMapComplete = ReadBoolean(bindingInBed, "physical_pin_map_complete")
+                metadataInBed.FootprintKnown = ReadBoolean(bindingInBed, "footprint_known")
+                metadataInBed.WorkerMetadataSource = pathInBed
+
+                Dim pinsInBed As JsonElement
+                If bindingInBed.TryGetProperty("pins", pinsInBed) AndAlso pinsInBed.ValueKind = JsonValueKind.Array Then
+                    For Each pinInBed As JsonElement In pinsInBed.EnumerateArray()
+                        Dim pinNameInBed As String = ReadString(pinInBed, "name")
+                        If String.IsNullOrWhiteSpace(pinNameInBed) Then Continue For
+                        Dim pinMetadataInBed As New BoardScriptPinMetadata With {
+                            .Name = pinNameInBed,
+                            .Direction = ReadString(pinInBed, "direction")
+                        }
+                        Dim numberInBed As JsonElement
+                        If pinInBed.TryGetProperty("number", numberInBed) AndAlso numberInBed.ValueKind = JsonValueKind.Number Then
+                            Dim parsedInBed As Integer
+                            If numberInBed.TryGetInt32(parsedInBed) Then pinMetadataInBed.Number = parsedInBed
+                        End If
+                        metadataInBed.Pins(pinNameInBed) = pinMetadataInBed
+                    Next
+                End If
+            Next
+        End Using
+    End Sub
+
+    Private Shared Function ReadString(elementInBed As JsonElement, propertyNameInBed As String) As String
+        Dim valueInBed As JsonElement
+        If elementInBed.TryGetProperty(propertyNameInBed, valueInBed) AndAlso valueInBed.ValueKind = JsonValueKind.String Then
+            Return If(valueInBed.GetString(), String.Empty)
+        End If
+        Return String.Empty
+    End Function
+
+    Private Shared Function ReadBoolean(elementInBed As JsonElement, propertyNameInBed As String) As Boolean
+        Dim valueInBed As JsonElement
+        If elementInBed.TryGetProperty(propertyNameInBed, valueInBed) Then
+            If valueInBed.ValueKind = JsonValueKind.True Then Return True
+            If valueInBed.ValueKind = JsonValueKind.False Then Return False
+        End If
+        Return False
+    End Function
+End Class
diff -ruN "foxsrc/Hardware/Board Script/BoardScriptCli.vb" "work/full/Hardware/Board Script/BoardScriptCli.vb"
--- "foxsrc/Hardware/Board Script/BoardScriptCli.vb"	1970-01-01 00:00:00.000000000 +0000
+++ "work/full/Hardware/Board Script/BoardScriptCli.vb"	2026-09-11 00:26:48.040302802 +0000
@@ -0,0 +1,62 @@
+Imports System
+Imports System.IO
+Imports System.Text
+
+Public Module BoardScriptCli
+    Public Function TryRunFromCommandLine(argsInBed As String()) As Boolean
+        If argsInBed Is Nothing OrElse argsInBed.Length < 2 Then Return False
+        If Not String.Equals(argsInBed(0), "--board-script-check", StringComparison.OrdinalIgnoreCase) Then Return False
+
+        Try
+            Dim scriptPathInBed As String = Path.GetFullPath(argsInBed(1))
+            Dim sourceRootInBed As String = AppContext.BaseDirectory
+            Dim reportPathInBed As String = Path.ChangeExtension(scriptPathInBed, ".check.txt")
+
+            Dim iInBed As Integer = 2
+            While iInBed < argsInBed.Length
+                Select Case argsInBed(iInBed).ToLowerInvariant()
+                    Case "--source-root"
+                        If iInBed + 1 >= argsInBed.Length Then Throw New ArgumentException("--source-root requires a path.")
+                        sourceRootInBed = Path.GetFullPath(argsInBed(iInBed + 1))
+                        iInBed += 2
+                    Case "--report"
+                        If iInBed + 1 >= argsInBed.Length Then Throw New ArgumentException("--report requires a path.")
+                        reportPathInBed = Path.GetFullPath(argsInBed(iInBed + 1))
+                        iInBed += 2
+                    Case Else
+                        Throw New ArgumentException("Unknown Board Script option '" & argsInBed(iInBed) & "'.")
+                End Select
+            End While
+
+            Dim definitionInBed As BoardScriptBoardDefinition = New BoardScriptParser(File.ReadAllText(scriptPathInBed)).ParseBoard()
+            Dim catalogInBed As BoardScriptPartCatalog = BoardScriptPartCatalog.LoadTree(sourceRootInBed)
+            Dim compiledInBed As BoardScriptCompiledBoard = New BoardScriptCompiler(catalogInBed, New BoardScriptWorkerRegistry()).Compile(definitionInBed)
+
+            Dim outputInBed As New StringBuilder()
+            outputInBed.AppendLine("Board Script: " & definitionInBed.Title)
+            outputInBed.AppendLine("  id                    : " & definitionInBed.BoardId)
+            outputInBed.AppendLine("  outline               : " & definitionInBed.Width.ToString("0.###") & " x " & definitionInBed.Height.ToString("0.###") & " " & definitionInBed.Units)
+            outputInBed.AppendLine("  components            : " & compiledInBed.Components.Count)
+            outputInBed.AppendLine("  nets                  : " & definitionInBed.Nets.Count)
+            outputInBed.AppendLine("  manufacturing ready   : " & compiledInBed.ManufacturingReady.ToString())
+            For Each componentInBed As BoardScriptCompiledComponent In compiledInBed.Components
+                Dim workerTextInBed As String = If(componentInBed.Worker Is Nothing, "<physical-only>", componentInBed.Worker.WorkerId)
+                outputInBed.AppendLine("  " & componentInBed.Definition.RefDes & " = " & componentInBed.Definition.PartId & " -> " & workerTextInBed)
+            Next
+            For Each diagnosticInBed As BoardScriptDiagnostic In compiledInBed.Diagnostics
+                outputInBed.AppendLine(diagnosticInBed.ToString())
+            Next
+
+            Dim reportDirectoryInBed As String = Path.GetDirectoryName(reportPathInBed)
+            If Not String.IsNullOrWhiteSpace(reportDirectoryInBed) Then Directory.CreateDirectory(reportDirectoryInBed)
+            File.WriteAllText(reportPathInBed, outputInBed.ToString())
+            Console.Write(outputInBed.ToString())
+            Console.WriteLine("Report: " & reportPathInBed)
+            Environment.ExitCode = If(compiledInBed.HasErrors, 2, 0)
+        Catch ex As Exception
+            Console.Error.WriteLine(ex.Message)
+            Environment.ExitCode = 2
+        End Try
+        Return True
+    End Function
+End Module
diff -ruN "foxsrc/Hardware/Board Script/BoardScriptCompiler.vb" "work/full/Hardware/Board Script/BoardScriptCompiler.vb"
--- "foxsrc/Hardware/Board Script/BoardScriptCompiler.vb"	1970-01-01 00:00:00.000000000 +0000
+++ "work/full/Hardware/Board Script/BoardScriptCompiler.vb"	2026-09-11 00:27:51.502371152 +0000
@@ -0,0 +1,130 @@
+Imports System
+Imports System.Collections.Generic
+
+Public NotInheritable Class BoardScriptCompiler
+    Private ReadOnly _catalog As BoardScriptPartCatalog
+    Private ReadOnly _workers As BoardScriptWorkerRegistry
+
+    Public Sub New(catalogInBed As BoardScriptPartCatalog, workersInBed As BoardScriptWorkerRegistry)
+        If catalogInBed Is Nothing Then Throw New ArgumentNullException(NameOf(catalogInBed))
+        If workersInBed Is Nothing Then Throw New ArgumentNullException(NameOf(workersInBed))
+        _catalog = catalogInBed
+        _workers = workersInBed
+    End Sub
+
+    Public Function Compile(definitionInBed As BoardScriptBoardDefinition) As BoardScriptCompiledBoard
+        If definitionInBed Is Nothing Then Throw New ArgumentNullException(NameOf(definitionInBed))
+        Dim resultInBed As New BoardScriptCompiledBoard With {.Definition = definitionInBed}
+
+        If Not String.Equals(definitionInBed.Units, "mm", StringComparison.OrdinalIgnoreCase) Then
+            AddError(resultInBed, "Prototype accepts only millimetres; got '" & definitionInBed.Units & "'.")
+        End If
+        If definitionInBed.Width <= 0 OrElse definitionInBed.Height <= 0 Then
+            AddError(resultInBed, "Board outline must have positive width and height.")
+        End If
+
+        Dim componentsByRefDesInBed As New Dictionary(Of String, BoardScriptCompiledComponent)(StringComparer.OrdinalIgnoreCase)
+        For Each componentInBed As BoardScriptComponentDefinition In definitionInBed.Components
+            If String.IsNullOrWhiteSpace(componentInBed.RefDes) Then
+                AddError(resultInBed, "Component has an empty reference designator.")
+                Continue For
+            End If
+            If componentsByRefDesInBed.ContainsKey(componentInBed.RefDes) Then
+                AddError(resultInBed, "Duplicate reference designator '" & componentInBed.RefDes & "'.")
+                Continue For
+            End If
+
+            Dim metadataInBed As BoardScriptPartMetadata = Nothing
+            If Not _catalog.TryGetPart(componentInBed.PartId, metadataInBed) Then
+                AddError(resultInBed, "Unknown part '" & componentInBed.PartId & "' at " & componentInBed.RefDes & ". Board Script will not invent a component.")
+                Continue For
+            End If
+
+            If componentInBed.Placement Is Nothing Then
+                AddError(resultInBed, componentInBed.RefDes & " has no placement.")
+            Else
+                ValidatePlacement(resultInBed, componentInBed)
+            End If
+
+            Dim compiledComponentInBed As New BoardScriptCompiledComponent With {
+                .Definition = componentInBed,
+                .Metadata = metadataInBed
+            }
+
+            If componentInBed.Straps.Count > 0 AndAlso String.IsNullOrWhiteSpace(metadataInBed.WorkerId) Then
+                AddError(resultInBed, componentInBed.RefDes & " declares straps, but part '" & componentInBed.PartId & "' has no behavioral worker binding to receive them.")
+            End If
+
+            If Not String.IsNullOrWhiteSpace(metadataInBed.WorkerId) Then
+                If Not _workers.CanCreate(metadataInBed.WorkerId) Then
+                    AddError(resultInBed, componentInBed.RefDes & " requests worker '" & metadataInBed.WorkerId & "', but no worker factory exists.")
+                Else
+                    Try
+                        compiledComponentInBed.Worker = _workers.Create(metadataInBed.WorkerId, componentInBed)
+                    Catch ex As Exception
+                        AddError(resultInBed, componentInBed.RefDes & " worker construction failed: " & ex.Message)
+                    End Try
+                End If
+            End If
+
+            resultInBed.Components.Add(compiledComponentInBed)
+            componentsByRefDesInBed.Add(componentInBed.RefDes, compiledComponentInBed)
+        Next
+
+        Dim netNamesInBed As New HashSet(Of String)(StringComparer.OrdinalIgnoreCase)
+        For Each netInBed As BoardScriptNetDefinition In definitionInBed.Nets
+            If Not netNamesInBed.Add(netInBed.Name) Then AddError(resultInBed, "Duplicate net name '" & netInBed.Name & "'.")
+            If netInBed.Endpoints.Count < 2 Then AddError(resultInBed, "Net '" & netInBed.Name & "' must have at least two endpoints.")
+            For Each endpointInBed As BoardScriptEndpoint In netInBed.Endpoints
+                Dim componentInBed As BoardScriptCompiledComponent = Nothing
+                If Not componentsByRefDesInBed.TryGetValue(endpointInBed.RefDes, componentInBed) Then
+                    AddError(resultInBed, "Net '" & netInBed.Name & "' references unknown component '" & endpointInBed.RefDes & "'.")
+                    Continue For
+                End If
+                If componentInBed.Metadata.Pins.Count = 0 Then
+                    AddError(resultInBed, "Net '" & netInBed.Name & "' references " & endpointInBed & ", but that part has no sourced logical-pin declaration yet.")
+                    Continue For
+                End If
+                If Not componentInBed.Metadata.Pins.ContainsKey(endpointInBed.PinName) Then
+                    AddError(resultInBed, "Net '" & netInBed.Name & "' references unknown pin '" & endpointInBed.PinName & "' on " & endpointInBed.RefDes & ".")
+                End If
+            Next
+        Next
+
+        resultInBed.ManufacturingReady = Not resultInBed.HasErrors
+        If resultInBed.ManufacturingReady Then
+            For Each componentInBed As BoardScriptCompiledComponent In resultInBed.Components
+                If Not componentInBed.Metadata.FootprintKnown OrElse
+                   (componentInBed.Metadata.Pins.Count > 0 AndAlso Not componentInBed.Metadata.PhysicalPinMapComplete) Then
+                    resultInBed.ManufacturingReady = False
+                    AddInfo(resultInBed, componentInBed.Definition.RefDes & " is logic-valid but not manufacturing-complete; footprint/pin evidence is incomplete.")
+                End If
+            Next
+        End If
+
+        Return resultInBed
+    End Function
+
+    Private Sub ValidatePlacement(resultInBed As BoardScriptCompiledBoard, componentInBed As BoardScriptComponentDefinition)
+        Dim placementInBed As BoardScriptPlacement = componentInBed.Placement
+        If placementInBed.X < 0 OrElse placementInBed.Y < 0 OrElse
+           placementInBed.X > resultInBed.Definition.Width OrElse placementInBed.Y > resultInBed.Definition.Height Then
+            AddError(resultInBed, componentInBed.RefDes & " placement lies outside the board outline.")
+        End If
+        If placementInBed.RotationDegrees Mod 90 <> 0 Then
+            AddError(resultInBed, componentInBed.RefDes & " prototype rotation must be a multiple of 90 degrees.")
+        End If
+        If Not String.Equals(placementInBed.Side, "top", StringComparison.OrdinalIgnoreCase) AndAlso
+           Not String.Equals(placementInBed.Side, "bottom", StringComparison.OrdinalIgnoreCase) Then
+            AddError(resultInBed, componentInBed.RefDes & " side must be top or bottom.")
+        End If
+    End Sub
+
+    Private Shared Sub AddError(resultInBed As BoardScriptCompiledBoard, messageInBed As String)
+        resultInBed.Diagnostics.Add(New BoardScriptDiagnostic With {.IsError = True, .Message = messageInBed})
+    End Sub
+
+    Private Shared Sub AddInfo(resultInBed As BoardScriptCompiledBoard, messageInBed As String)
+        resultInBed.Diagnostics.Add(New BoardScriptDiagnostic With {.IsError = False, .Message = messageInBed})
+    End Sub
+End Class
diff -ruN "foxsrc/Hardware/Board Script/BoardScriptLexer.vb" "work/full/Hardware/Board Script/BoardScriptLexer.vb"
--- "foxsrc/Hardware/Board Script/BoardScriptLexer.vb"	1970-01-01 00:00:00.000000000 +0000
+++ "work/full/Hardware/Board Script/BoardScriptLexer.vb"	2026-09-11 00:26:54.639681621 +0000
@@ -0,0 +1,205 @@
+Imports System
+Imports System.Globalization
+Imports System.Text
+
+Public Enum BoardScriptTokenKind
+    Identifier = 0
+    StringLiteral = 1
+    Number = 2
+    LeftBrace = 3
+    RightBrace = 4
+    Colon = 5
+    Dot = 6
+    Equals = 7
+    Semicolon = 8
+    EndOfFile = 9
+End Enum
+
+Public Structure BoardScriptToken
+    Public Kind As BoardScriptTokenKind
+    Public Text As String
+    Public Line As Integer
+    Public Column As Integer
+
+    Public Sub New(kindInBed As BoardScriptTokenKind, textInBed As String, lineInBed As Integer, columnInBed As Integer)
+        Kind = kindInBed
+        Text = textInBed
+        Line = lineInBed
+        Column = columnInBed
+    End Sub
+End Structure
+
+Public NotInheritable Class BoardScriptParseException
+    Inherits Exception
+
+    Public Sub New(messageInBed As String, tokenInBed As BoardScriptToken)
+        MyBase.New("Board Script line " & tokenInBed.Line & ", column " & tokenInBed.Column & ": " & messageInBed)
+    End Sub
+End Class
+
+Public NotInheritable Class BoardScriptLexer
+    Private ReadOnly _source As String
+    Private _position As Integer
+    Private _line As Integer = 1
+    Private _column As Integer = 1
+
+    Public Sub New(sourceInBed As String)
+        _source = If(sourceInBed, String.Empty)
+    End Sub
+
+    Public Function NextToken() As BoardScriptToken
+        SkipWhitespaceAndComments()
+        If _position >= _source.Length Then
+            Return New BoardScriptToken(BoardScriptTokenKind.EndOfFile, String.Empty, _line, _column)
+        End If
+
+        Dim startLineInBed As Integer = _line
+        Dim startColumnInBed As Integer = _column
+        Dim chInBed As Char = _source(_position)
+
+        Select Case chInBed
+            Case "{"c
+                Advance()
+                Return New BoardScriptToken(BoardScriptTokenKind.LeftBrace, "{", startLineInBed, startColumnInBed)
+            Case "}"c
+                Advance()
+                Return New BoardScriptToken(BoardScriptTokenKind.RightBrace, "}", startLineInBed, startColumnInBed)
+            Case ":"c
+                Advance()
+                Return New BoardScriptToken(BoardScriptTokenKind.Colon, ":", startLineInBed, startColumnInBed)
+            Case "."c
+                Advance()
+                Return New BoardScriptToken(BoardScriptTokenKind.Dot, ".", startLineInBed, startColumnInBed)
+            Case "="c
+                Advance()
+                Return New BoardScriptToken(BoardScriptTokenKind.Equals, "=", startLineInBed, startColumnInBed)
+            Case ";"c
+                Advance()
+                Return New BoardScriptToken(BoardScriptTokenKind.Semicolon, ";", startLineInBed, startColumnInBed)
+            Case """"c
+                Return ReadString()
+        End Select
+
+        If Char.IsDigit(chInBed) OrElse (chInBed = "-"c AndAlso PeekDigit()) Then Return ReadNumber()
+        If IsIdentifierStart(chInBed) Then Return ReadIdentifier()
+
+        Throw New BoardScriptParseException("Unexpected character '" & chInBed & "'.",
+                                            New BoardScriptToken(BoardScriptTokenKind.Identifier, chInBed.ToString(), startLineInBed, startColumnInBed))
+    End Function
+
+    Private Function ReadString() As BoardScriptToken
+        Dim startLineInBed As Integer = _line
+        Dim startColumnInBed As Integer = _column
+        Advance()
+        Dim builderInBed As New StringBuilder()
+        While _position < _source.Length
+            Dim chInBed As Char = _source(_position)
+            If chInBed = """"c Then
+                Advance()
+                Return New BoardScriptToken(BoardScriptTokenKind.StringLiteral, builderInBed.ToString(), startLineInBed, startColumnInBed)
+            End If
+            If chInBed = "\"c Then
+                Advance()
+                If _position >= _source.Length Then Exit While
+                Dim escapedInBed As Char = _source(_position)
+                Select Case escapedInBed
+                    Case "n"c : builderInBed.Append(ControlChars.Lf)
+                    Case "r"c : builderInBed.Append(ControlChars.Cr)
+                    Case "t"c : builderInBed.Append(ControlChars.Tab)
+                    Case """"c : builderInBed.Append(""""c)
+                    Case "\"c : builderInBed.Append("\"c)
+                    Case Else : builderInBed.Append(escapedInBed)
+                End Select
+                Advance()
+            Else
+                builderInBed.Append(chInBed)
+                Advance()
+            End If
+        End While
+        Throw New BoardScriptParseException("Unterminated string literal.",
+                                            New BoardScriptToken(BoardScriptTokenKind.StringLiteral, builderInBed.ToString(), startLineInBed, startColumnInBed))
+    End Function
+
+    Private Function ReadNumber() As BoardScriptToken
+        Dim startInBed As Integer = _position
+        Dim startLineInBed As Integer = _line
+        Dim startColumnInBed As Integer = _column
+        If _source(_position) = "-"c Then Advance()
+        While _position < _source.Length AndAlso Char.IsDigit(_source(_position))
+            Advance()
+        End While
+        If _position < _source.Length AndAlso _source(_position) = "."c Then
+            Advance()
+            While _position < _source.Length AndAlso Char.IsDigit(_source(_position))
+                Advance()
+            End While
+        End If
+        Return New BoardScriptToken(BoardScriptTokenKind.Number,
+                                    _source.Substring(startInBed, _position - startInBed),
+                                    startLineInBed,
+                                    startColumnInBed)
+    End Function
+
+    Private Function ReadIdentifier() As BoardScriptToken
+        Dim startInBed As Integer = _position
+        Dim startLineInBed As Integer = _line
+        Dim startColumnInBed As Integer = _column
+        While _position < _source.Length AndAlso IsIdentifierPart(_source(_position))
+            Advance()
+        End While
+        Return New BoardScriptToken(BoardScriptTokenKind.Identifier,
+                                    _source.Substring(startInBed, _position - startInBed),
+                                    startLineInBed,
+                                    startColumnInBed)
+    End Function
+
+    Private Sub SkipWhitespaceAndComments()
+        Do
+            While _position < _source.Length AndAlso Char.IsWhiteSpace(_source(_position))
+                Advance()
+            End While
+            If _position >= _source.Length Then Return
+
+            If _source(_position) = "#"c Then
+                SkipToEndOfLine()
+                Continue Do
+            End If
+            If _source(_position) = "/"c AndAlso _position + 1 < _source.Length AndAlso _source(_position + 1) = "/"c Then
+                Advance()
+                Advance()
+                SkipToEndOfLine()
+                Continue Do
+            End If
+            Exit Do
+        Loop
+    End Sub
+
+    Private Sub SkipToEndOfLine()
+        While _position < _source.Length AndAlso _source(_position) <> ControlChars.Lf
+            Advance()
+        End While
+    End Sub
+
+    Private Function PeekDigit() As Boolean
+        Return _position + 1 < _source.Length AndAlso Char.IsDigit(_source(_position + 1))
+    End Function
+
+    Private Shared Function IsIdentifierStart(chInBed As Char) As Boolean
+        Return Char.IsLetter(chInBed) OrElse chInBed = "_"c OrElse chInBed = "$"c
+    End Function
+
+    Private Shared Function IsIdentifierPart(chInBed As Char) As Boolean
+        Return Char.IsLetterOrDigit(chInBed) OrElse chInBed = "_"c OrElse chInBed = "-"c OrElse chInBed = "$"c
+    End Function
+
+    Private Sub Advance()
+        If _position >= _source.Length Then Return
+        If _source(_position) = ControlChars.Lf Then
+            _line += 1
+            _column = 1
+        Else
+            _column += 1
+        End If
+        _position += 1
+    End Sub
+End Class
