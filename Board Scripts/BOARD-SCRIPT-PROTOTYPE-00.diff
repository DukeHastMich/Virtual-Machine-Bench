+Imports System
+Imports System.Collections.Generic
+
+Public Enum BoardScriptValueKind
+    Text = 0
+    Number = 1
+    Boolean = 2
+End Enum
+
+Public NotInheritable Class BoardScriptValue
+    Public ReadOnly Property Kind As BoardScriptValueKind
+    Public ReadOnly Property TextValue As String
+    Public ReadOnly Property NumberValue As Double
+    Public ReadOnly Property BooleanValue As Boolean
+
+    Private Sub New(kindInBed As BoardScriptValueKind,
+                    textInBed As String,
+                    numberInBed As Double,
+                    booleanInBed As Boolean)
+        Kind = kindInBed
+        TextValue = If(textInBed, String.Empty)
+        NumberValue = numberInBed
+        BooleanValue = booleanInBed
+    End Sub
+
+    Public Shared Function FromText(valueInBed As String) As BoardScriptValue
+        Return New BoardScriptValue(BoardScriptValueKind.Text, valueInBed, 0, False)
+    End Function
+
+    Public Shared Function FromNumber(valueInBed As Double) As BoardScriptValue
+        Return New BoardScriptValue(BoardScriptValueKind.Number,
+                                    valueInBed.ToString(Globalization.CultureInfo.InvariantCulture),
+                                    valueInBed,
+                                    False)
+    End Function
+
+    Public Shared Function FromBoolean(valueInBed As Boolean) As BoardScriptValue
+        Return New BoardScriptValue(BoardScriptValueKind.Boolean,
+                                    If(valueInBed, "true", "false"),
+                                    0,
+                                    valueInBed)
+    End Function
+
+    Public Function AsInteger(nameInBed As String) As Integer
+        If Kind <> BoardScriptValueKind.Number OrElse Math.Truncate(NumberValue) <> NumberValue Then
+            Throw New InvalidOperationException(nameInBed & " requires an integer value.")
+        End If
+        Return CInt(NumberValue)
+    End Function
+
+    Public Function AsBoolean(nameInBed As String) As Boolean
+        If Kind <> BoardScriptValueKind.Boolean Then
+            Throw New InvalidOperationException(nameInBed & " requires true or false.")
+        End If
+        Return BooleanValue
+    End Function
+
+    Public Overrides Function ToString() As String
+        Return TextValue
+    End Function
+End Class
+
+Public NotInheritable Class BoardScriptPlacement
+    Public Property X As Double
+    Public Property Y As Double
+    Public Property RotationDegrees As Integer
+    Public Property Side As String = "top"
+End Class
+
+Public NotInheritable Class BoardScriptComponentDefinition
+    Public Property RefDes As String = String.Empty
+    Public Property PartId As String = String.Empty
+    Public Property Placement As BoardScriptPlacement
+    Public ReadOnly Property Straps As New Dictionary(Of String, BoardScriptValue)(StringComparer.OrdinalIgnoreCase)
+End Class
+
+Public NotInheritable Class BoardScriptEndpoint
+    Public Property RefDes As String = String.Empty
+    Public Property PinName As String = String.Empty
+
+    Public Overrides Function ToString() As String
+        Return RefDes & "." & PinName
+    End Function
+End Class
+
+Public NotInheritable Class BoardScriptNetDefinition
+    Public Property Name As String = String.Empty
+    Public ReadOnly Property Endpoints As New List(Of BoardScriptEndpoint)()
+End Class
+
+Public NotInheritable Class BoardScriptBoardDefinition
+    Public Property BoardId As String = String.Empty
+    Public Property Title As String = String.Empty
+    Public Property Units As String = "mm"
+    Public Property Width As Double
+    Public Property Height As Double
+    Public ReadOnly Property Components As New List(Of BoardScriptComponentDefinition)()
+    Public ReadOnly Property Nets As New List(Of BoardScriptNetDefinition)()
+End Class
+
+Public NotInheritable Class BoardScriptDiagnostic
+    Public Property IsError As Boolean
+    Public Property Message As String = String.Empty
+
+    Public Overrides Function ToString() As String
+        Return If(IsError, "ERROR: ", "INFO : ") & Message
+    End Function
+End Class
+
+Public NotInheritable Class BoardScriptPinMetadata
+    Public Property Name As String = String.Empty
+    Public Property Number As Integer?
+    Public Property Direction As String = String.Empty
+End Class
+
+Public NotInheritable Class BoardScriptPartMetadata
+    Public Property PartId As String = String.Empty
+    Public Property Manufacturer As String = String.Empty
+    Public Property PartNumber As String = String.Empty
+    Public Property Package As String = String.Empty
+    Public Property Role As String = String.Empty
+    Public Property WorkerId As String = String.Empty
+    Public Property PhysicalPinMapComplete As Boolean
+    Public Property FootprintKnown As Boolean
+    Public ReadOnly Property Pins As New Dictionary(Of String, BoardScriptPinMetadata)(StringComparer.OrdinalIgnoreCase)
+    Public Property PartsMetadataSource As String = String.Empty
+    Public Property WorkerMetadataSource As String = String.Empty
+End Class
+
+Public Interface IBoardScriptWorker
+    ReadOnly Property WorkerId As String
+    ReadOnly Property SiliconIdentity As String
+    Function DiagnosticText() As String
+End Interface
+
+Public NotInheritable Class BoardScriptCompiledComponent
+    Public Property Definition As BoardScriptComponentDefinition
+    Public Property Metadata As BoardScriptPartMetadata
+    Public Property Worker As IBoardScriptWorker
+End Class
+
+Public NotInheritable Class BoardScriptCompiledBoard
+    Public Property Definition As BoardScriptBoardDefinition
+    Public ReadOnly Property Components As New List(Of BoardScriptCompiledComponent)()
+    Public ReadOnly Property Diagnostics As New List(Of BoardScriptDiagnostic)()
+    Public Property ManufacturingReady As Boolean
+
+    Public ReadOnly Property HasErrors As Boolean
+        Get
+            For Each diagnosticInBed As BoardScriptDiagnostic In Diagnostics
+                If diagnosticInBed.IsError Then Return True
+            Next
+            Return False
+        End Get
+    End Property
+End Class
diff -ruN "foxsrc/Hardware/Board Script/BoardScriptParser.vb" "work/full/Hardware/Board Script/BoardScriptParser.vb"
--- "foxsrc/Hardware/Board Script/BoardScriptParser.vb"	1970-01-01 00:00:00.000000000 +0000
+++ "work/full/Hardware/Board Script/BoardScriptParser.vb"	2026-09-11 00:26:00.790211996 +0000
@@ -0,0 +1,158 @@
+Imports System
+Imports System.Globalization
+
+Public NotInheritable Class BoardScriptParser
+    Private ReadOnly _lexer As BoardScriptLexer
+    Private _current As BoardScriptToken
+
+    Public Sub New(sourceInBed As String)
+        _lexer = New BoardScriptLexer(sourceInBed)
+        _current = _lexer.NextToken()
+    End Sub
+
+    Public Function ParseBoard() As BoardScriptBoardDefinition
+        ExpectKeyword("board")
+        Dim resultInBed As New BoardScriptBoardDefinition With {.BoardId = ExpectIdentifier()}
+        Expect(BoardScriptTokenKind.LeftBrace)
+
+        While _current.Kind <> BoardScriptTokenKind.RightBrace
+            If _current.Kind = BoardScriptTokenKind.EndOfFile Then Throw ErrorInBed("Expected '}' before end of file.")
+            Select Case _current.Text.ToLowerInvariant()
+                Case "title"
+                    Advance()
+                    resultInBed.Title = Expect(BoardScriptTokenKind.StringLiteral).Text
+                    Expect(BoardScriptTokenKind.Semicolon)
+                Case "units"
+                    Advance()
+                    resultInBed.Units = ExpectIdentifier()
+                    Expect(BoardScriptTokenKind.Semicolon)
+                Case "outline"
+                    Advance()
+                    resultInBed.Width = ExpectNumber()
+                    resultInBed.Height = ExpectNumber()
+                    Expect(BoardScriptTokenKind.Semicolon)
+                Case "component"
+                    resultInBed.Components.Add(ParseComponent())
+                Case "net"
+                    resultInBed.Nets.Add(ParseNet())
+                Case Else
+                    Throw ErrorInBed("Unknown board statement '" & _current.Text & "'.")
+            End Select
+        End While
+        Expect(BoardScriptTokenKind.RightBrace)
+        Expect(BoardScriptTokenKind.EndOfFile)
+        If String.IsNullOrWhiteSpace(resultInBed.Title) Then resultInBed.Title = resultInBed.BoardId
+        Return resultInBed
+    End Function
+
+    Private Function ParseComponent() As BoardScriptComponentDefinition
+        ExpectKeyword("component")
+        Dim resultInBed As New BoardScriptComponentDefinition With {.RefDes = ExpectIdentifier()}
+        Expect(BoardScriptTokenKind.Colon)
+        resultInBed.PartId = ExpectIdentifier()
+        Expect(BoardScriptTokenKind.LeftBrace)
+
+        While _current.Kind <> BoardScriptTokenKind.RightBrace
+            Select Case _current.Text.ToLowerInvariant()
+                Case "place"
+                    Advance()
+                    Dim placementInBed As New BoardScriptPlacement()
+                    placementInBed.X = ExpectNumber()
+                    placementInBed.Y = ExpectNumber()
+                    ExpectKeyword("rot")
+                    placementInBed.RotationDegrees = CInt(ExpectNumber())
+                    ExpectKeyword("side")
+                    placementInBed.Side = ExpectIdentifier()
+                    Expect(BoardScriptTokenKind.Semicolon)
+                    resultInBed.Placement = placementInBed
+                Case "strap"
+                    Advance()
+                    Dim nameInBed As String = ExpectIdentifier()
+                    Expect(BoardScriptTokenKind.Equals)
+                    resultInBed.Straps(nameInBed) = ParseValue()
+                    Expect(BoardScriptTokenKind.Semicolon)
+                Case Else
+                    Throw ErrorInBed("Unknown component statement '" & _current.Text & "'.")
+            End Select
+        End While
+        Expect(BoardScriptTokenKind.RightBrace)
+        Return resultInBed
+    End Function
+
+    Private Function ParseNet() As BoardScriptNetDefinition
+        ExpectKeyword("net")
+        Dim resultInBed As New BoardScriptNetDefinition With {.Name = ExpectIdentifier()}
+        Expect(BoardScriptTokenKind.LeftBrace)
+        While _current.Kind <> BoardScriptTokenKind.RightBrace
+            ExpectKeyword("endpoint")
+            Dim endpointInBed As New BoardScriptEndpoint With {.RefDes = ExpectIdentifier()}
+            Expect(BoardScriptTokenKind.Dot)
+            endpointInBed.PinName = ExpectIdentifier()
+            Expect(BoardScriptTokenKind.Semicolon)
+            resultInBed.Endpoints.Add(endpointInBed)
+        End While
+        Expect(BoardScriptTokenKind.RightBrace)
+        Return resultInBed
+    End Function
+
+    Private Function ParseValue() As BoardScriptValue
+        Select Case _current.Kind
+            Case BoardScriptTokenKind.StringLiteral
+                Dim textInBed As String = _current.Text
+                Advance()
+                Return BoardScriptValue.FromText(textInBed)
+            Case BoardScriptTokenKind.Number
+                Return BoardScriptValue.FromNumber(ExpectNumber())
+            Case BoardScriptTokenKind.Identifier
+                If String.Equals(_current.Text, "true", StringComparison.OrdinalIgnoreCase) Then
+                    Advance()
+                    Return BoardScriptValue.FromBoolean(True)
+                End If
+                If String.Equals(_current.Text, "false", StringComparison.OrdinalIgnoreCase) Then
+                    Advance()
+                    Return BoardScriptValue.FromBoolean(False)
+                End If
+                Dim identifierInBed As String = _current.Text
+                Advance()
+                Return BoardScriptValue.FromText(identifierInBed)
+            Case Else
+                Throw ErrorInBed("Expected a string, number, true, false, or identifier value.")
+        End Select
+    End Function
+
+    Private Function ExpectNumber() As Double
+        Dim tokenInBed As BoardScriptToken = Expect(BoardScriptTokenKind.Number)
+        Dim resultInBed As Double
+        If Not Double.TryParse(tokenInBed.Text, NumberStyles.Float, CultureInfo.InvariantCulture, resultInBed) Then
+            Throw New BoardScriptParseException("Invalid number '" & tokenInBed.Text & "'.", tokenInBed)
+        End If
+        Return resultInBed
+    End Function
+
+    Private Function ExpectIdentifier() As String
+        Return Expect(BoardScriptTokenKind.Identifier).Text
+    End Function
+
+    Private Sub ExpectKeyword(keywordInBed As String)
+        If _current.Kind <> BoardScriptTokenKind.Identifier OrElse
+           Not String.Equals(_current.Text, keywordInBed, StringComparison.OrdinalIgnoreCase) Then
+            Throw ErrorInBed("Expected '" & keywordInBed & "'.")
+        End If
+        Advance()
+    End Sub
+
+    Private Function Expect(kindInBed As BoardScriptTokenKind) As BoardScriptToken
+        If _current.Kind <> kindInBed Then Throw ErrorInBed("Expected " & kindInBed.ToString() & ".")
+        Dim resultInBed As BoardScriptToken = _current
+        Advance()
+        Return resultInBed
+    End Function
+
+    Private Sub Advance()
+        _current = _lexer.NextToken()
+    End Sub
+
+    Private Function ErrorInBed(messageInBed As String) As BoardScriptParseException
+        Return New BoardScriptParseException(messageInBed, _current)
+    End Function
+End Class
diff -ruN "foxsrc/Hardware/Board Script/BoardScriptWorkers.vb" "work/full/Hardware/Board Script/BoardScriptWorkers.vb"
--- "foxsrc/Hardware/Board Script/BoardScriptWorkers.vb"	1970-01-01 00:00:00.000000000 +0000
+++ "work/full/Hardware/Board Script/BoardScriptWorkers.vb"	2026-09-11 00:26:00.797559187 +0000
@@ -0,0 +1,89 @@
+Imports System
+Imports System.Collections.Generic
+
+Public NotInheritable Class BoardScriptWorkerRegistry
+    Private ReadOnly _factories As New Dictionary(Of String, Func(Of BoardScriptComponentDefinition, IBoardScriptWorker))(StringComparer.OrdinalIgnoreCase)
+
+    Public Sub New()
+        Register("headland.ht12-a", Function(componentInBed) New HeadlandHt12BoardScriptWorker(componentInBed))
+        Register("ct.neat.82c211", Function(componentInBed) New Ct82C211BoardScriptWorker(componentInBed))
+        Register("ct.neat.82c212", Function(componentInBed) New Ct82C212BoardScriptWorker(componentInBed))
+        Register("ct.neat.82c215", Function(componentInBed) New Ct82C215BoardScriptWorker(componentInBed))
+        Register("ct.neat.82c206", Function(componentInBed) New Ct82C206BoardScriptWorker(componentInBed))
+    End Sub
+
+    Public Sub Register(workerIdInBed As String, factoryInBed As Func(Of BoardScriptComponentDefinition, IBoardScriptWorker))
+        If String.IsNullOrWhiteSpace(workerIdInBed) Then Throw New ArgumentNullException(NameOf(workerIdInBed))
+        If factoryInBed Is Nothing Then Throw New ArgumentNullException(NameOf(factoryInBed))
+        _factories(workerIdInBed) = factoryInBed
+    End Sub
+
+    Public Function CanCreate(workerIdInBed As String) As Boolean
+        Return Not String.IsNullOrWhiteSpace(workerIdInBed) AndAlso _factories.ContainsKey(workerIdInBed)
+    End Function
+
+    Public Function Create(workerIdInBed As String, componentInBed As BoardScriptComponentDefinition) As IBoardScriptWorker
+        Dim factoryInBed As Func(Of BoardScriptComponentDefinition, IBoardScriptWorker) = Nothing
+        If Not _factories.TryGetValue(workerIdInBed, factoryInBed) Then
+            Throw New InvalidOperationException("No Board Script worker factory is registered for '" & workerIdInBed & "'.")
+        End If
+        Return factoryInBed(componentInBed)
+    End Function
+End Class
+
+Public NotInheritable Class HeadlandHt12BoardScriptWorker
+    Implements IBoardScriptWorker
+
+    Private ReadOnly _siliconInBed As HeadlandHt12
+
+    Public Sub New(componentInBed As BoardScriptComponentDefinition)
+        If componentInBed Is Nothing Then Throw New ArgumentNullException(NameOf(componentInBed))
+        Dim strapsInBed As New Ht12PowerOnStraps With {
+            .RamConfigurationCode = 0,
+            .AtBusLowSpeed = False,
+            .ZeroWaitMainMemory = False,
+            .ExtraWaitStateMode = 0,
+            .TcStrapHigh = False
+        }
+
+        For Each entryInBed As KeyValuePair(Of String, BoardScriptValue) In componentInBed.Straps
+            Select Case entryInBed.Key.ToLowerInvariant()
+                Case "ramconfigurationcode"
+                    strapsInBed.RamConfigurationCode = CByte(entryInBed.Value.AsInteger(entryInBed.Key) And &H7)
+                Case "atbuslowspeed"
+                    strapsInBed.AtBusLowSpeed = entryInBed.Value.AsBoolean(entryInBed.Key)
+                Case "zerowaitmainmemory"
+                    strapsInBed.ZeroWaitMainMemory = entryInBed.Value.AsBoolean(entryInBed.Key)
+                Case "extrawaitstatemode"
+                    strapsInBed.ExtraWaitStateMode = CByte(entryInBed.Value.AsInteger(entryInBed.Key) And &H3)
+                Case "tcstraphigh"
+                    strapsInBed.TcStrapHigh = entryInBed.Value.AsBoolean(entryInBed.Key)
+                Case Else
+                    Throw New InvalidOperationException("HT12/A has no sourced Board Script strap named '" & entryInBed.Key & "'.")
+            End Select
+        Next
+        _siliconInBed = New HeadlandHt12(strapsInBed)
+    End Sub
+
+    Public ReadOnly Property Silicon As HeadlandHt12
+        Get
+            Return _siliconInBed
+        End Get
+    End Property
+
+    Public ReadOnly Property WorkerId As String Implements IBoardScriptWorker.WorkerId
+        Get
+            Return "headland.ht12-a"
+        End Get
+    End Property
+
+    Public ReadOnly Property SiliconIdentity As String Implements IBoardScriptWorker.SiliconIdentity
+        Get
+            Return _siliconInBed.Identity
+        End Get
+    End Property
+
+    Public Function DiagnosticText() As String Implements IBoardScriptWorker.DiagnosticText
+        Return _siliconInBed.DiagnosticText()
+    End Function
+End Class
diff -ruN "foxsrc/Hardware/Board Script/README.md" "work/full/Hardware/Board Script/README.md"
--- "foxsrc/Hardware/Board Script/README.md"	1970-01-01 00:00:00.000000000 +0000
+++ "work/full/Hardware/Board Script/README.md"	2026-09-11 00:26:48.708490744 +0000
@@ -0,0 +1,61 @@
+# VMB Board Script (`.bs`) prototype
+
+Board Script is a declarative motherboard composition language.  It does **not** contain silicon emulation.  A `.bs` file chooses documented parts, places them, applies board-level straps, and joins sourced pins into named nets.  Behavioral workers remain reusable code modules.
+
+The prototype deliberately separates four truths:
+
+1. `PARTS-METADATA.json` — manufacturer, part number, package, role, provenance.
+2. `WORKER-METADATA.json` — part-to-worker binding plus sourced logical/physical pin knowledge.
+3. `.bs` — board population, placement, straps, and nets.
+4. worker code — actual silicon behavior.
+
+The compiler refuses unknown part IDs, missing workers, unknown pins, duplicate refdes/nets, impossible board coordinates, unsupported rotations, and invalid strap values.  Missing fabrication evidence does **not** become guessed geometry: a board may be logic-valid while `ManufacturingReady=False`.
+
+## Prototype grammar
+
+```text
+board <board-id> {
+    title "human name";
+    units mm;
+    outline <width> <height>;
+
+    component <refdes> : <part-id> {
+        place <x> <y> rot <0|90|180|270> side <top|bottom>;
+        strap <name> = <string|number|true|false>;
+    }
+
+    net <name> {
+        endpoint <refdes>.<pin>;
+        endpoint <refdes>.<pin>;
+        ...
+    }
+}
+```
+
+`#` and `//` introduce line comments.
+
+## First worker bindings
+
+- `headland-ht12-a` -> `headland.ht12-a` -> real existing `HeadlandHt12` worker.
+- `ct-82c211` -> `ct.neat.82c211` -> split 82C211 prototype worker.
+- `ct-82c212` -> `ct.neat.82c212` -> split 82C212 prototype worker.
+- `ct-82c215` -> `ct.neat.82c215` -> split 82C215 prototype worker.
+- `ct-82c206` -> `ct.neat.82c206` -> split 82C206 prototype worker.
+
+The split NEAT workers are intentionally **parallel prototypes**, not replacements for the already-green live `NeatCs8221Chipset`.  Migration only happens after behavioral equivalence testing.
+
+## Command-line prototype
+
+After a build on a machine with the .NET toolchain:
+
+```text
+VirtualComputer.Modern.exe --board-script-check "Board Scripts\Samples\NEAT-CS8221-Reference.bs" --source-root "C:\path\to\VMB"
+```
+
+The command parses the script, recursively loads part/worker metadata from the supplied source root, constructs registered workers, validates nets/placement, and reports whether the board has enough evidence to be considered manufacturing-ready. It also writes `<script>.check.txt` unless `--report <path>` is supplied.
+
+The included `INVALID-Invented-Part-Must-Fail.bs` is a required negative test.  If it ever compiles successfully, the Board Script compiler has violated VMB's no-fantasy-hardware rule.
+
+## Deliberately not in prototype 0
+
+No runtime motherboard hot-swap, automatic ISA fabric binding, DRAM topology compiler, full package pin maps, footprints, placement collision geometry, power-domain/ERC, trace routing, or manufacturing export is claimed yet.  Those belong after this grammar/worker boundary proves stable.
diff -ruN "foxsrc/Hardware/Chipsets/Chips and Technologies/CS8221 NEAT/CtNeatBoardScriptWorkers.vb" "work/full/Hardware/Chipsets/Chips and Technologies/CS8221 NEAT/CtNeatBoardScriptWorkers.vb"
--- "foxsrc/Hardware/Chipsets/Chips and Technologies/CS8221 NEAT/CtNeatBoardScriptWorkers.vb"	1970-01-01 00:00:00.000000000 +0000
+++ "work/full/Hardware/Chipsets/Chips and Technologies/CS8221 NEAT/CtNeatBoardScriptWorkers.vb"	2026-09-11 00:26:00.799318491 +0000
@@ -0,0 +1,181 @@
+Imports System
+
+' Board-Script-first split of the physical four-chip CS8221 NEAT family.
+' This DOES NOT replace the proven live NeatCs8221Chipset class yet.  It gives
+' each actual package a worker boundary so Board Script can compose the board
+' without pretending the four-package chipset is one physical IC.
+
+Public NotInheritable Class Ct82C211BoardScriptWorker
+    Implements IBoardScriptWorker
+
+    Private _reg60 As Byte
+    Private _reg61 As Byte
+    Private _reg62 As Byte
+
+    Public Sub New(componentInBed As BoardScriptComponentDefinition)
+        If componentInBed Is Nothing Then Throw New ArgumentNullException(NameOf(componentInBed))
+        If componentInBed.Straps.Count <> 0 Then Throw New InvalidOperationException("82C211 prototype exposes no board straps yet; its indexed registers are firmware state.")
+        ResetRegisters()
+    End Sub
+
+    Public Sub ResetRegisters()
+        _reg60 = 0
+        _reg61 = &H45
+        _reg62 = &H18
+    End Sub
+
+    Public Function ReadIndexedRegister(indexInBed As Byte) As Byte
+        Select Case indexInBed
+            Case &H60 : Return CByte(_reg60 And &H34)
+            Case &H61 : Return _reg61
+            Case &H62 : Return _reg62
+            Case Else : Return &HFF
+        End Select
+    End Function
+
+    Public Sub WriteIndexedRegister(indexInBed As Byte, valueInBed As Byte)
+        Select Case indexInBed
+            Case &H60 : _reg60 = CByte(valueInBed And &H34)
+            Case &H61 : _reg61 = valueInBed
+            Case &H62 : _reg62 = CByte(valueInBed And &H3F)
+        End Select
+    End Sub
+
+    Public ReadOnly Property WorkerId As String Implements IBoardScriptWorker.WorkerId
+        Get
+            Return "ct.neat.82c211"
+        End Get
+    End Property
+
+    Public ReadOnly Property SiliconIdentity As String Implements IBoardScriptWorker.SiliconIdentity
+        Get
+            Return "Chips and Technologies 82C211 CPU/Bus Controller"
+        End Get
+    End Property
+
+    Public Function DiagnosticText() As String Implements IBoardScriptWorker.DiagnosticText
+        Return SiliconIdentity & " REG60=" & _reg60.ToString("X2") & " REG61=" & _reg61.ToString("X2") & " REG62=" & _reg62.ToString("X2")
+    End Function
+End Class
+
+Public NotInheritable Class Ct82C212BoardScriptWorker
+    Implements IBoardScriptWorker
+
+    Private ReadOnly _registers(11) As Byte
+
+    Public Sub New(componentInBed As BoardScriptComponentDefinition)
+        If componentInBed Is Nothing Then Throw New ArgumentNullException(NameOf(componentInBed))
+        If componentInBed.Straps.Count <> 0 Then Throw New InvalidOperationException("82C212 prototype exposes no board straps yet; its indexed registers are firmware state.")
+        ResetRegisters()
+    End Sub
+
+    Public Sub ResetRegisters()
+        Array.Clear(_registers, 0, _registers.Length)
+        _registers(0) = 0
+        _registers(1) = &HE
+        _registers(6) = &H80
+        _registers(7) = &H6B
+    End Sub
+
+    Public Function ReadIndexedRegister(indexInBed As Byte) As Byte
+        If indexInBed < &H64 OrElse indexInBed > &H6F Then Return &HFF
+        Return _registers(indexInBed - &H64)
+    End Function
+
+    Public Sub WriteIndexedRegister(indexInBed As Byte, valueInBed As Byte)
+        If indexInBed < &H65 OrElse indexInBed > &H6F Then Return
+        Dim slotInBed As Integer = indexInBed - &H64
+        Select Case indexInBed
+            Case &H65, &H67, &H68, &H69, &H6B, &H6D, &H6E
+                _registers(slotInBed) = valueInBed
+            Case &H66
+                _registers(slotInBed) = CByte(valueInBed And &H80)
+            Case &H6A, &H6C
+                _registers(slotInBed) = CByte(valueInBed And &HE0)
+            Case &H6F
+                _registers(slotInBed) = CByte(valueInBed And &HE6)
+        End Select
+    End Sub
+
+    Public ReadOnly Property WorkerId As String Implements IBoardScriptWorker.WorkerId
+        Get
+            Return "ct.neat.82c212"
+        End Get
+    End Property
+
+    Public ReadOnly Property SiliconIdentity As String Implements IBoardScriptWorker.SiliconIdentity
+        Get
+            Return "Chips and Technologies 82C212 Page/Interleave and EMS Memory Controller"
+        End Get
+    End Property
+
+    Public Function DiagnosticText() As String Implements IBoardScriptWorker.DiagnosticText
+        Return SiliconIdentity & " REG65=" & _registers(1).ToString("X2") & " REG6A=" & _registers(6).ToString("X2") & " REG6B=" & _registers(7).ToString("X2")
+    End Function
+End Class
+
+Public NotInheritable Class Ct82C215BoardScriptWorker
+    Implements IBoardScriptWorker
+
+    Public Sub New(componentInBed As BoardScriptComponentDefinition)
+        If componentInBed Is Nothing Then Throw New ArgumentNullException(NameOf(componentInBed))
+        If componentInBed.Straps.Count <> 0 Then Throw New InvalidOperationException("82C215 is a data/address buffer; no guest-visible strap surface is declared in this prototype.")
+    End Sub
+
+    Public ReadOnly Property WorkerId As String Implements IBoardScriptWorker.WorkerId
+        Get
+            Return "ct.neat.82c215"
+        End Get
+    End Property
+
+    Public ReadOnly Property SiliconIdentity As String Implements IBoardScriptWorker.SiliconIdentity
+        Get
+            Return "Chips and Technologies 82C215 Data/Address Buffer"
+        End Get
+    End Property
+
+    Public Function DiagnosticText() As String Implements IBoardScriptWorker.DiagnosticText
+        Return SiliconIdentity & " (physical parity/buffer worker boundary; no indexed registers)"
+    End Function
+End Class
+
+Public NotInheritable Class Ct82C206BoardScriptWorker
+    Implements IBoardScriptWorker
+
+    Private _configuration As Byte
+
+    Public Sub New(componentInBed As BoardScriptComponentDefinition)
+        If componentInBed Is Nothing Then Throw New ArgumentNullException(NameOf(componentInBed))
+        If componentInBed.Straps.Count <> 0 Then Throw New InvalidOperationException("82C206 prototype exposes no board straps yet; configuration register 01h is firmware state.")
+        ResetRegisters()
+    End Sub
+
+    Public Sub ResetRegisters()
+        _configuration = &HC0
+    End Sub
+
+    Public Function ReadIndexedRegister(indexInBed As Byte) As Byte
+        If indexInBed = &H1 Then Return _configuration
+        Return &HFF
+    End Function
+
+    Public Sub WriteIndexedRegister(indexInBed As Byte, valueInBed As Byte)
+        If indexInBed = &H1 Then _configuration = valueInBed
+    End Sub
+
+    Public ReadOnly Property WorkerId As String Implements IBoardScriptWorker.WorkerId
+        Get
+            Return "ct.neat.82c206"
+        End Get
+    End Property
+
+    Public ReadOnly Property SiliconIdentity As String Implements IBoardScriptWorker.SiliconIdentity
+        Get
+            Return "Chips and Technologies 82C206 Integrated Peripherals Controller"
+        End Get
+    End Property
+
+    Public Function DiagnosticText() As String Implements IBoardScriptWorker.DiagnosticText
+        Return SiliconIdentity & " REG01=" & _configuration.ToString("X2")
+    End Function
+End Class
